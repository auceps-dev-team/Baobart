# ============================================================================
# BAOBART — configuration 12-factor
#
# Le MÊME code tourne sur Vercel et sur un VPS : seules ces variables changent.
# Copier en `.env` puis remplir. Ne JAMAIS committer `.env`.
#
# ────────────────────────────────────────────────────────────────────────────
# TROIS SECTIONS, ET LA DIFFÉRENCE COMPTE
#
#   ① REQUIS       lu par le code aujourd'hui. Sans lui, ça casse.
#   ② OPTIONNEL    lu par le code, avec un comportement de repli acceptable.
#   ③ À VENIR      décrit un module qui n'existe pas encore. Le renseigner
#                  n'a aucun effet : c'est une note d'intention, pas un
#                  réglage. Regroupé en fin de fichier pour qu'on ne perde pas
#                  une heure à chercher pourquoi « ça ne prend pas ».
# ============================================================================


# ============================================================================
# ① REQUIS
# ============================================================================

# --- Base de données --------------------------------------------------------
# Self-host (docker compose) : identifiants du docker-compose.yml.
DATABASE_URL=postgresql://baobart:baobart@localhost:5433/baobart?schema=public

# Connexion DIRECTE, sans pooler, réservée aux migrations.
#
# Obligatoire : le schéma la déclare, et Prisma refuse de démarrer sans elle.
# En développement, c'est la même URL que ci-dessus. En production elle diffère :
# `DATABASE_URL` passe par le pooler (une fonction serverless ouvre une
# connexion par invocation, et sans pooler Postgres s'épuise), tandis qu'un
# pooler en mode transaction ne sait pas jouer une migration dans une seule
# session. D'où deux URL.
DIRECT_URL=postgresql://baobart:baobart@localhost:5433/baobart?schema=public

# Production, exemple Neon/Supabase :
# DATABASE_URL=postgresql://…?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://…   (port direct, sans pooler)

# --- Adresse publique du site -----------------------------------------------
# L'origine par laquelle le PUBLIC atteint Baobart, protocole compris.
#
# Elle sert à fabriquer les liens que portent les courriels : réinitialisation
# du mot de passe, liens de téléchargement. Sans elle, ces courriels ne partent
# pas — l'écran Système · Configuration l'annonce comme une panne.
#
# Elle n'est PAS déduite de l'en-tête `Host` de la requête, et c'est
# intentionnel : `Host` est fourni par l'appelant. Le déduire permettrait à
# quiconque de demander une réinitialisation pour le compte d'autrui en
# annonçant son propre domaine — la victime recevrait un courriel authentique
# dont le lien mène chez l'attaquant. C'est une faille connue, elle a un nom :
# l'empoisonnement du lien de réinitialisation.
#
# En production : HTTPS obligatoire. Un lien de réinitialisation est un
# identifiant temporaire ; en clair sur le réseau, il se ramasse.
# ATTENTION AU PORT : le serveur de developpement ecoute sur 3100
#
# `package.json` lance `next dev -p 3100`, et cette variable disait 3000. Les
# liens de courriel pointaient donc vers un port ou rien n'ecoute -- visible
# tout de suite, donc benin.
#
# WebAuthn, lui, ne pardonne pas : `origineAttendue()` compare cette valeur a
# l'origine que le navigateur envoie. Un port qui ne correspond pas fait
# refuser TOUTES les cles d'acces, avec un message de bibliotheque qui ne
# nomme pas la variable en cause.
APP_URL=http://localhost:3100

# --- Médias (S3-compatible) -------------------------------------------------
# MinIO en développement ; R2, S3 ou Supabase Storage en production.
# MinIO local N'EST PAS joignable depuis Vercel : en déploiement, ces valeurs
# doivent pointer un stockage public.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=baobart-media
S3_ACCESS_KEY_ID=baobart
S3_SECRET_ACCESS_KEY=baobart-dev-secret
S3_FORCE_PATH_STYLE=true

# Domaine par lequel le NAVIGATEUR lit les aperçus publics.
#
# C'est bien `S3_PUBLIC_URL` que le code interroge — pas `CDN_URL`, qui n'a
# jamais été lu. Laissé vide, on retombe sur `S3_ENDPOINT`, ce qui convient en
# local. En production : l'URL du CDN, en HTTPS. Une valeur en HTTP ferait
# refuser les images par le navigateur sur une page servie en HTTPS.
S3_PUBLIC_URL=


# ============================================================================
# ② OPTIONNEL — lu, avec un repli
# ============================================================================

# Seuil au-delà duquel une requête est journalisée comme lente (ms).
SLOW_QUERY_MS=200

# Base des tests d'intégration. Par défaut : la même instance, base
# `baobart_test`.
DATABASE_URL_TEST=postgresql://baobart:baobart@localhost:5433/baobart_test?schema=public

# La base du navigateur (tests E2E). Séparée de celle d'intégration, et pas
# par coquetterie : les deux suites doivent pouvoir tourner en même temps, et
# un TRUNCATE d'un côté viderait les données que l'autre parcourt.
DATABASE_URL_E2E=postgresql://baobart:baobart@localhost:5433/baobart_e2e?schema=public

# Secret de l'ordonnanceur Vercel.
#
# Vercel signe ses appels de cron avec ce jeton ; la route qui prépare les
# versements refuse tout ce qui ne le porte pas. Vide, la route répond 404 et
# aucun versement n'est préparé — c'est le repli sûr : mieux vaut ne rien
# préparer que laisser l'URL ouverte à tous.
# Une valeur longue et aléatoire : openssl rand -base64 32
CRON_SECRET=

# Sel de l'empreinte qui compte les vues et les clics de publicité par
# visiteur (`lib/publicites/plafond.ts`). C'est la seule lecture de cette
# variable dans le code : la connexion ne l'exige PAS, contrairement à ce
# qu'affirme le commentaire du module.
#
# Vide, le comptage fonctionne quand même — et c'est le piège : l'empreinte
# d'une adresse IP sans secret se retrouve en essayant les quatre milliards
# d'adresses. À poser en production. Une valeur longue et aléatoire :
# openssl rand -base64 32
AUTH_SECRET=

# Clé serveur du score anti-bot (reCAPTCHA v3, `lib/securite/antibot.ts`).
# Vide : seuls le champ leurre et le délai minimal protègent les formulaires.
#
# ⚠️ Constaté le 08/10/2026 : aucune page ne produit encore le jeton que ce
# score demande. La poser allume l'indicateur « tiers » de l'écran Système,
# mais aucun score n'est réellement calculé tant que les formulaires n'envoient
# pas de jeton.
# RECAPTCHA_SECRET=

# Préfixe des clés Redis. Défaut : `baobart:`. À changer seulement pour faire
# cohabiter deux instances du projet sur le même Redis.
# REDIS_PREFIX=baobart:

# Port du serveur que lance Playwright. Défaut : 3200, distinct du serveur de
# développement (3100) pour que les deux tournent ensemble.
# E2E_PORT=3200

# Nom du conteneur PostgreSQL que `scripts/setup-test-db.mjs` interroge.
# Défaut : `baobart-postgres`, celui du docker-compose.
# POSTGRES_CONTAINER=baobart-postgres

# --- Emails -----------------------------------------------------------------
# La file d'attente existe (`EmailOutbox`) et l'inscription y dépose déjà un
# message. Sans pilote configuré, rien ne part : les lignes restent en attente
# et se voient dans /dashboard/systeme/configuration.
# EMAIL_DRIVER=console        # écrit dans les journaux, n'envoie rien
# EMAIL_DRIVER=resend         # envoi réel
# RESEND_API_KEY=
# EMAIL_FROM="Baobart <bonjour@baobart.com>"
# EMAIL_DRIVER=smtp           # serveur de courriel classique
# SMTP_URL=smtps://utilisateur:motdepasse@courriel.exemple.com
#   `smtps://` chiffre dès la connexion (465). `smtp://` démarre en clair et
#   monte en TLS par STARTTLS (587) — exigé, sauf vers localhost où le trafic
#   ne quitte pas la machine (attrape-courriels de développement).
#   Un mot de passe contenant @ ou / doit être encodé : %40, %2F.

# ── Double authentification (TOTP) ───────────────────────────────────────────
#
# Chiffre les secrets TOTP en base (AES-256-GCM). Une phrase d'au moins seize
# caractères ; elle est passée par scrypt, pas employée telle quelle.
#
# SANS ELLE, L'ACTIVATION DE LA 2FA EST REFUSÉE — franchement, avec un message.
# Le repli qui aurait écrit le secret en clair serait pire que l'absence : la
# fonctionnalité aurait l'air en place et ne protégerait rien.
#
# La changer rend illisibles tous les secrets déjà posés : les comptes concernés
# devront réactiver leur 2FA. Leurs codes de secours, eux, continuent de
# fonctionner — ils ne dépendent pas de cette clé.
TOTP_ENCRYPTION_KEY=

# Sortie « standalone » de Next, requise par l'image Docker. Le Dockerfile la
# pose lui-même. NE PAS la définir sur Vercel : elle y produit un build
# incompatible.
# BUILD_STANDALONE=1

# --- Paiement simulé --------------------------------------------------------
# Ouvre l'achat des ressources payantes SANS qu'aucun argent ne circule : la
# commande s'inscrit, le créateur est crédité, rien n'est encaissé.
# À NE JAMAIS POSER EN PRODUCTION. L'écran /dashboard/systeme/configuration
# l'affiche alors en PANNE : les ressources payantes se prendraient sans payer,
# et les versements dus reposeraient sur des ventes qui n'ont rien rapporté.
# Les commandes ainsi créées portent `provider = "simulation"`.
# CHECKOUT_SIMULATION_ENABLED=1

# --- Encaissement mobile money ----------------------------------------------
# L'opérateur branché. Vide ou inconnu : aucun paiement n'est possible, et le
# tunnel d'achat refuse franchement plutôt que d'ouvrir une commande qui
# n'aboutira jamais.
#
#   paystack     règle en XOF — l'opérateur de référence pour Baobart
#   flutterwave  API v4, parcours en trois appels
#   bac-a-sable  la chaîne entière sans opérateur — voir plus bas
#
# La simulation ci-dessus PRIME sur ce réglage quand elle est ouverte : les
# faire cohabiter mélangerait dans la même base des ventes payées et des ventes
# gratuites, et plus personne ne saurait lesquelles ont rapporté.
PAYMENTS_DRIVER=

# Le secret dont le bac à sable signe ses rappels (HMAC-SHA256, en-tête
# `x-baobart-signature`). Seize caractères au minimum, sinon le pilote se
# déclare non configuré.
#
# Pourquoi un bac à sable exige un secret : un webhook qui accepte tout
# n'éprouve pas le webhook. Le but est justement de pouvoir rejouer un appel,
# en forger un faux, en envoyer un au mauvais montant — et voir chacun refusé.
#
#   openssl rand -hex 24
PAYMENTS_SANDBOX_SECRET=

# --- Paystack ---------------------------------------------------------------
# La clé secrète, et rien d'autre : elle sert AUSSI à vérifier la signature des
# rappels (HMAC-SHA512 hexadécimal, en-tête `x-paystack-signature`). Il n'y a
# pas de secret de webhook distinct chez eux.
#
# Doit commencer par `sk_test_` ou `sk_live_`, sinon le pilote se déclare non
# configuré — ce qui évite qu'un espace réservé recopié depuis la documentation
# passe pour une vraie clé.
#
# ⚠️ ATTENTION AUX MONTANTS. Paystack veut le montant principal ×100, y compris
# pour le franc CFA qui n'a pas de sous-unité. Baobart garde ses montants en
# unités mineures ISO. La conversion vit dans `pilotes/paystack.ts` et elle est
# testée : ne la court-circuitez pas.
#
# Devises acceptées : NGN, GHS, KES, ZAR, USD, XOF. Le pilote refuse d'ouvrir
# sur les autres plutôt que d'envoyer une devise qui sera rejetée.
#
# ⚠️ VERSEMENTS SORTANTS : DÉSACTIVEZ L'OTP SUR LES TRANSFERTS.
# Paystack peut exiger un code à usage unique, envoyé au propriétaire du
# compte, pour CHAQUE virement. Tant que ce réglage est actif, aucun
# versement automatique n'est possible — et aucune quantité de code n'y
# changera rien. Le passage s'arrête alors net et le journalise en erreur,
# plutôt que de faire échouer tous les créateurs pour la même raison.
# Le réglage se trouve sur leur tableau de bord, section Transfers.
#
# L'argent versé sort du SOLDE Paystack : il faut avoir encaissé avant de
# pouvoir verser. Un solde insuffisant est un refus définitif, pas une
# panne — le versement échoue et ses soldes repartent au cycle suivant.
PAYSTACK_SECRET_KEY=

# --- Flutterwave (API v4) ---------------------------------------------------
# Trois valeurs, et les trois sont nécessaires. Sans le hash de webhook, on
# saurait ouvrir un paiement mais pas reconnaître la réponse — de l'argent
# partirait, et rien ne le confirmerait.
#
# L'authentification est un échange OAuth : le client_id et le client_secret
# sont troqués contre un jeton qui vit dix minutes. Le pilote le met en cache et
# le renouvelle une minute avant son terme.
#
# Le hash sert à vérifier la signature des rappels (HMAC-SHA256 rendu en
# BASE64 — pas en hexadécimal comme Paystack ; c'est déclaré sur leur tableau
# de bord, en-tête `flutterwave-signature`).
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_SECRET_HASH=

# `sandbox` (par défaut) ou `production`. On ne bascule que sur décision
# explicite : un oubli dans l'autre sens encaisserait pour de vrai.
FLUTTERWAVE_ENV=sandbox

# --- Limitation du débit ----------------------------------------------------
# Où vivent les compteurs qui bornent la connexion, l'inscription, l'oubli de
# mot de passe et les rappels d'opérateur.
#
#   memoire   dans le processus. Le défaut, et le bon choix en développement.
#   redis     partagé. Le seul qui tienne dès qu'il y a plus d'une instance.
#   aucun     ne compte rien.
#
# ⚠️ `memoire` MENT EN PRODUCTION. Chaque instance a ses propres compteurs :
# dix instances autorisent dix fois la limite, et rien ne le signale — la page
# affiche « protégé », les compteurs tournent, et l'attaque passe. C'est le pire
# genre de panne, celle qui a l'air de fonctionner. L'écran Système ·
# Configuration l'affiche donc en AVERTISSEMENT dès qu'on est en production.
RATE_LIMIT_DRIVER=memoire

# L'adresse de Redis. Requise seulement par le pilote `redis`.
# En développement, le compose en fournit un : redis://localhost:6379
REDIS_URL=

# --- SMS (relances d'abonnement Ndank, connexion par téléphone) -------------
# LE SEUL CANAL QUI COÛTE. Un courriel se compte par milliers sans y penser ;
# un SMS se paie à l'unité, et un défaut de boucle se lit sur une facture.
#
#   aucun   — par défaut. N'envoie rien, et le dit. Ndank passe au canal suivant
#             et NE NOTE PAS la relance : l'abonné sera repris demain plutôt que
#             coupé sans avoir été prévenu. La connexion par téléphone reste
#             « Bientôt disponible ».
#   console — écrit le message dans le journal, CODES DE CONNEXION COMPRIS. Pour
#             le développement : on y lit le code. Refusé pour les codes quand
#             NODE_ENV=production — un code au journal ouvrirait le compte.
#   twilio  — envoie pour de vrai, par un opérateur.
#   textbee — envoie depuis un téléphone Android (textbee.dev, libre et
#             auto-hébergeable). Idéal pour éprouver la connexion par SMS sans
#             compte chez un opérateur ; mais « accepté » ne veut pas dire
#             « reçu » : le téléphone doit être allumé et en ligne.
#   smsgate — envoie depuis un téléphone Android avec SMS Gateway for Android
#             (sms-gate.app, libre). Même idée que textbee, mais peut tourner
#             SANS AUCUN SERVICE TIERS : le téléphone ouvre lui-même un
#             serveur sur le réseau local. Mêmes réserves sur « accepté ».
#
# Le défaut est « aucun » et non « console » : un canal payant ne doit jamais
# commencer à tourner parce que personne n'a rien posé.
SMS_DRIVER=aucun

# Twilio. Requis par le pilote `twilio` — sans eux, il retombe sur « aucun ».
# `TWILIO_FROM` ou `TWILIO_MESSAGING_SERVICE_SID`, l'un des deux suffit ; avec un
# service de messagerie, Twilio choisit lui-même l'expéditeur le mieux placé pour
# le pays visé, ce qui compte quand on écrit à quatre pays d'Afrique de l'Ouest.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# textbee. Requis par le pilote `textbee` — sans clé, il retombe sur « aucun ».
#   1. créer un compte sur textbee.dev, installer l'application sur le téléphone
#      Android qui enverra les SMS (textbee.dev/download), lui donner le droit
#      d'envoyer des SMS ;
#   2. dans le tableau de bord textbee : « register device / generate API key »,
#      puis scanner le QR code avec l'application ;
#   3. poser la clé ci-dessous, et `SMS_DRIVER=textbee`.
# `TEXTBEE_DEVICE_ID` est facultatif : sans lui, textbee prend l'appareil par
# défaut du compte. `TEXTBEE_BASE_URL` sert à une instance auto-hébergée ; elle
# doit être en https, sauf sur la machine même (http://localhost).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# TEXTBEE_BASE_URL=https://api.textbee.dev

# SMS Gateway for Android. Requis par le pilote `smsgate` — sans utilisateur
# et mot de passe, il retombe sur « aucun ».
#   1. installer l'application sur le téléphone Android qui enverra les SMS
#      (github.com/capcom6/android-sms-gateway, rubrique Releases), lui donner
#      le droit d'envoyer des SMS ;
#   2. au choix :
#      — serveur local : activer « Local Server », puis appuyer sur « Offline »
#        pour le démarrer. L'écran affiche l'adresse du téléphone et les
#        identifiants. SMSGATE_URL=http://<adresse-du-téléphone>:8080 ;
#      — nuage : activer « Cloud Server », appuyer sur « Online ». L'écran
#        affiche les identifiants ; laisser SMSGATE_URL vide ;
#   3. poser les identifiants ci-dessous, et `SMS_DRIVER=smsgate`.
# En local, le téléphone parle en HTTP (sans chiffrement) : seule une adresse
# privée (192.168.x.x, 10.x.x.x, 172.16–31.x.x, localhost) est acceptée en
# http, et les identifiants circulent en clair sur ce réseau. Pour un essai
# chez soi ; en production, le nuage ou un serveur privé en https.
# `SMSGATE_DEVICE_ID` est facultatif (choix d'un téléphone parmi plusieurs).
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=
# SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1

# Le plafond journalier d'envois, par instance. 500 par défaut.
# Ce n'est pas de la prudence décorative : c'est la seule chose qui borne le
# coût d'un bogue qu'on n'a pas encore écrit. Au-delà, plus rien ne part et une
# erreur est journalisée. À doubler d'un vrai plafond chez l'opérateur, qui lui
# sait compter à travers toutes les instances.
SMS_PLAFOND_JOUR=500

# --- Notifications poussees (PWA) -------------------------------------------
# Le seul canal gratuit qui atteint quelqu'un sans qu'il ouvre l'application.
# Aux paliers J+2 et J+5, la notification passe AVANT le SMS : chaque abonne
# qui a installé Baobart est un SMS qu'on n'envoie pas.
#
# `pnpm push:cles` tire la paire. À ne faire QU'UNE FOIS : la clé publique est
# ce à quoi chaque navigateur s'abonne, et en changer rend TOUS les abonnements
# existants muets d'un coup, sans erreur nulle part — les gens continuent de
# croire qu'ils seront prévenus. Si elle doit changer, vider `PushSubscription`
# dans la foulée pour que chacun se réinscrive.
PUSH_DRIVER=aucun

# La publique part au navigateur : c'est sa nature, elle n'est pas secrète.
VAPID_PUBLIC_KEY=
# La privée ne quitte jamais le serveur. Qui l'a peut écrire à tous les abonnés
# en notre nom.
VAPID_PRIVATE_KEY=
# Une vraie adresse de contact, `mailto:` ou `https://`. Certains services de
# poussée refusent la requête sans elle et pas les autres : un défaut qui
# n'apparaîtrait que sur un navigateur sur trois.
VAPID_SUBJECT=

# --- Interrupteurs d'exploitation -------------------------------------------
# Absentes, les fonctionnalités sont ouvertes. Ces variables ne savent que
# fermer : mettre `1` sur un module non écrit ne l'ouvrira pas.
# Valeurs qui ferment : 0, false, off, non.
# FEATURE_ENVOI_FICHIERS=0    # coupe l'envoi de fichiers (incident stockage)
# FEATURE_VERSEMENTS=0        # suspend la préparation des versements

# --- Connexion par un tiers -------------------------------------------------
#
# Un fournisseur est ACTIF — son bouton cliquable — quand il est configuré ET
# qu'une route le reçoit (`branche` dans lib/auth/providers.ts). Sinon le bouton
# reste visible et répond « Bientôt disponible ».
#
# Au 08/10/2026 :
#   — Téléphone : BRANCHÉ. Configuré par le pilote SMS ci-dessus (`SMS_DRIVER`),
#     pas par des variables à lui : il s'allume dès qu'un code peut partir. Il
#     ouvre un compte dont le numéro a été vérifié dans le profil, et la 2FA
#     reste exigée si elle est active.
#   — Google, Apple et les autres : NON BRANCHÉS — le flux OAuth n'est pas
#     écrit. Poser leurs variables n'allume aucun bouton ; l'écran Système les
#     affiche « configuré mais non branché », en attention.

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

AUTH_INSTAGRAM_ID=
AUTH_INSTAGRAM_SECRET=

AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

AUTH_FIGMA_ID=
AUTH_FIGMA_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=


# ============================================================================
# ③ À VENIR — aucun effet aujourd'hui
#
# Ces variables décrivent des modules qui ne sont pas construits. Les
# renseigner sur Vercel ne fera rien : aucun code ne les lit pour l'instant.
# Elles restent ici parce que le nom retenu fait partie des décisions déjà
# prises.
#
# Ce qui est construit — paiement, courriel, 2FA — a quitté cette section :
# un réglage lu par le code n'a rien à faire parmi les notes d'intention.
# ============================================================================

# --- App --------------------------------------------------------------------
# Les sessions sont des cookies adossés à la base : il n'y a pas de NextAuth.
# `AUTH_SECRET` n'est plus ici — il est lu, voir la section ②.
# AUTH_URL=http://localhost:3100
# APP_DEFAULT_CURRENCY=XOF
# APP_DEFAULT_LOCALE=fr-FR

# --- Redis (cache feed, compteurs, quotes FX) -------------------------------
# REDIS_URL=redis://localhost:6379

# --- Autres opérateurs de paiement -----------------------------------------
# Paystack, Flutterwave et le bac à sable SONT branchés : leurs variables
# vivent dans la section ① (`PAYMENTS_DRIVER`, `PAYSTACK_SECRET_KEY`,
# `FLUTTERWAVE_CLIENT_ID`…). Ne pas reprendre ici les anciens noms
# `FLUTTERWAVE_PUBLIC_KEY` / `FLUTTERWAVE_SECRET_KEY` /
# `FLUTTERWAVE_WEBHOOK_SECRET` : aucun code ne les lit, et un pilote renseigné
# sous ces noms resterait « non configuré » sans que rien ne dise pourquoi.
#
# Seuls CinetPay et Stripe sont encore à venir :
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Jobs asynchrones -------------------------------------------------------
# JOBS_DRIVER=bullmq
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- SMS --------------------------------------------------------------------
# Le mobile money confirme par code à usage unique : le jour où l'encaissement
# existera, il faudra un envoi de SMS pour le vérifier.
# SMS_PROVIDER=
# SMS_API_KEY=

# --- IA ---------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_REQUESTS_PER_HOUR=10

# --- Observabilité ----------------------------------------------------------
# SENTRY_DSN=
# LOG_LEVEL=info
