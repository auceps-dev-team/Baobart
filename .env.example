# ============================================================================
# BAOBART — configuration 12-factor
# Le MÊME code tourne sur Vercel et sur un VPS : seules ces variables changent.
# Copier en `.env` puis remplir. Ne JAMAIS committer `.env`.
# ============================================================================

# --- App --------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_DEFAULT_CURRENCY=XOF
APP_DEFAULT_LOCALE=fr-FR

# --- Base de données --------------------------------------------------------
# Self-host (docker compose) : identifiants du docker-compose.yml
DATABASE_URL=postgresql://baobart:baobart@localhost:5433/baobart?schema=public
# Production : ajouter le pooling (PgBouncer, Neon/Supabase pooler) — PLAN §8.2-4
# DATABASE_URL=postgresql://...?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://...   # migrations : connexion directe, sans pooler

# --- Redis (cache feed, compteurs, sessions, quotes FX) ---------------------
REDIS_URL=redis://localhost:6379

# --- Médias (S3-compatible : MinIO en dev, R2/S3 en prod) -------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=baobart-media
S3_ACCESS_KEY_ID=baobart
S3_SECRET_ACCESS_KEY=baobart-dev-secret
S3_FORCE_PATH_STYLE=true
CDN_URL=

# --- Auth -------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Login social (SPEC_AUTH_INTEGRATIONS — partie 1)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Téléphone OTP — mode principal en Afrique de l'Ouest
SMS_PROVIDER=
SMS_API_KEY=

# --- Paiements (mobile money d'abord) ---------------------------------------
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Jobs asynchrones (Inngest en cloud, BullMQ en self-host) ---------------
JOBS_DRIVER=bullmq
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Emails -----------------------------------------------------------------
EMAIL_DRIVER=smtp
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM="Baobart <bonjour@baobart.com>"

# --- IA (Assistant, fiches produit, résumés) --------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_REQUESTS_PER_HOUR=10

# --- Observabilité ----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
SLOW_QUERY_MS=200
