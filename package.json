{
  "name": "baobart",
  "version": "1.59.1",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "test:unite": "vitest run --project unite",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "db:demo:medias": "node --env-file=.env scripts/medias-demo.mjs",
    "db:demo:catalogue": "tsx prisma/seed-demo-catalogue.ts",
    "db:demo:verif": "node scripts/verif-catalogue.mjs",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "admin:promouvoir": "node scripts/promouvoir-admin.mjs",
    "push:cles": "node scripts/cles-push.mjs",
    "versements": "tsx --conditions=react-server --env-file=.env scripts/versements-du-cycle.ts",
    "comptes:test": "tsx --conditions=react-server --env-file=.env scripts/comptes-de-test.ts",
    "db:e2e:setup": "node scripts/setup-test-db.mjs e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.26",
      "nanoid": "3.3.18",
      "sharp": "0.35.3",
      "deepmerge-ts": "8.0.2"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@prisma/client": "^6.3.1",
    "ioredis": "^6.0.0",
    "next": "^15.1.6",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.5.22",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prisma": "^6.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
