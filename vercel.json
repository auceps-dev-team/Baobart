{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm db:generate && pnpm build",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/versements",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/courriels",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/commandes",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/abonnements",
      "schedule": "0 8 * * *"
    }
  ]
}
