// ============================================================================
// 9. CROISSANCE  (M2-M7 — FK scalaires pour l'instant)
// ============================================================================

model Affiliate {
  id                 String   @id @default(cuid())
  sellerId           String
  affiliateUserId    String?
  type               String   @default("DIRECT") // DIRECT (peer) | GLOBAL (ambassadeur)
  basisPoints        Int      @default(1000) // 10 %
  cookieLifetimeDays Int      @default(7)
  status             String   @default("active")
  createdAt          DateTime @default(now())

  credits AffiliateCredit[]

  @@index([sellerId])
  @@index([affiliateUserId])
}

model AffiliateRequest {
  id          String   @id @default(cuid())
  sellerId    String
  applicantId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([sellerId, applicantId])
}

model AffiliateCredit {
  id          String   @id @default(cuid())
  affiliateId String
  orderItemId String
  amount      Int
  status      String   @default("on_hold")
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

model OfferCode {
  id                     String    @id @default(cuid())
  sellerId               String
  code                   String
  type                   String // PERCENT | FIXED
  amount                 Int
  durationDays           Int?
  maxUses                Int?
  usesCount              Int       @default(0)
  isCancellationDiscount Boolean   @default(false)
  productIds             Json      @default("[]") // [] = tous les produits
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())

  @@unique([sellerId, code])
}

model Upsell {
  id               String  @id @default(cuid())
  sellerId         String
  triggerProductId String
  offerProductId   String
  variantId        String?
  discountPercent  Int?
  isActive         Boolean @default(true)

  @@index([triggerProductId])
}

model SentAbandonedCartEmail {
  id        String   @id @default(cuid())
  cartId    String   @unique
  sentAt    DateTime @default(now())
  converted Boolean  @default(false)
}

model CustomField {
  id         String  @id @default(cuid())
  productId  String
  name       String
  fieldType  String // TEXT | CHOICE | BOOLEAN | FILE | TERMS
  isRequired Boolean @default(false)
  position   Int     @default(0)
  options    Json    @default("[]")

  @@index([productId])
}

model Post {
  id             String    @id @default(cuid())
  sellerId       String
  title          String
  body           String    @db.Text
  audienceFilter Json      @default("{}") // tous | acheteurs | followers | segment
  scheduledAt    DateTime?
  sentAt         DateTime?
  openRate       Decimal?  @db.Decimal(5, 4)
  createdAt      DateTime  @default(now())

  deliveries PostDelivery[]

  @@index([sellerId, createdAt])
}

model PostDelivery {
  id       String    @id @default(cuid())
  postId   String
  email    String
  status   String    @default("pending") // pending | sent | opened | bounced
  sentAt   DateTime?
  openedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
}

// ============================================================================
// 10. CONFIANCE, MODÉRATION & AUDIT
// ============================================================================

model BlockedObject {
  id          String    @id @default(cuid())
  objectType  String // IP | EMAIL | PHONE | CARD | OBJECT
  objectValue String
  reason      String?
  expiresAt   DateTime? // expiration automatique (6 mois pour les IP)
  createdAt   DateTime  @default(now())

  @@unique([objectType, objectValue])
  @@index([expiresAt])
}

/// Journal des décisions de risque.
///
/// Ce n'est pas de la traçabilité décorative : c'est la table que relit le
/// contrôle de solde négatif pour savoir **qui** avait posé une probation et si
/// **quelqu'un d'autre a tranché depuis**. Sans elle, la levée automatique ne
/// peut pas distinguer sa propre décision de celle d'un administrateur — et
/// finirait par défaire un jugement humain.
model RiskStateChange {
  id        String        @id @default(cuid())
  userId    String
  fromState UserRiskState
  toState   UserRiskState
  /// Qui a décidé : identifiant d'administrateur, ou nom du contrôle
  /// automatique (voir AUTEUR_CONTROLE_SOLDE dans lib/domain/trust.ts).
  author    String
  reason    String?       @db.Text
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, author, createdAt])
}

model ModerationLog {
  id         String   @id @default(cuid())
  entityType String // product | work_item | comment | forum_post
  entityId   String
  reason     String
  action     String // blocked | flagged | approved
  actorId    String? // null = automatique
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model FraudWarning {
  id          String   @id @default(cuid())
  orderItemId String
  processor   String
  riskLevel   String
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
}

// ============================================================================
// 11. MÉDIAS — upload direct presign + pipeline Shield
// ============================================================================

enum EmailStatus {
  PENDING
  SENDING
  SENT
  /// Échec définitif : plus aucune tentative automatique.
  FAILED
  /// Fermé à la main. Une adresse qui n'existe plus resterait rouge à jamais
  /// et masquerait les vraies pannes.
  ABANDONED
}

enum EmailTemplate {
  BIENVENUE
  REINITIALISATION_MOT_DE_PASSE
  RECU_ACHAT
  LIEN_TELECHARGEMENT
  AVIS_VERSEMENT
}

/// File d'attente des messages transactionnels.
///
/// Un message part **après** la transaction qui le justifie. S'il partait
/// pendant, une commande annulée aurait déjà envoyé son reçu ; s'il partait
/// avant, une panne d'expéditeur ferait échouer la commande. On écrit donc
/// l'intention dans la même transaction que le fait, et un passage l'envoie
/// ensuite.
model EmailOutbox {
  id String @id @default(cuid())

  /// Ce qui empêche le doublon.
  ///
  /// Dérivée du fait qui justifie l'envoi — « recu-<orderItemId> » — et non
  /// d'un hasard : un webhook rejoué par l'opérateur doit retomber sur la même
  /// clé et se faire refuser, plutôt que d'envoyer un second reçu.
  idempotencyKey String @unique

  recipient String
  template  EmailTemplate
  /// Les variables du modèle. Peut contenir un lien de téléchargement :
  /// ne jamais l'afficher tel quel dans un écran ni dans un journal.
  payload   Json

  status     EmailStatus @default(PENDING)
  attempts   Int         @default(0)
  lastError  String?

  /// Avant cette date, la ligne n'est pas réclamée. Porte le recul progressif.
  nextAttemptAt DateTime @default(now())

  /// Posée à la réclamation. Une ligne SENDING dont la réclamation traîne
  /// signale un processus mort en plein envoi.
  claimedAt DateTime?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// L'index du passage : ce qui est dû, dans l'ordre où c'est dû.
  @@index([status, nextAttemptAt])
  /// La supervision lit par récence.
  @@index([createdAt])
  @@index([status, createdAt])
}

model MediaAsset {
  id               String      @id @default(cuid())
  ownerId          String
  purpose          String // shot | product | avatar | banner | preview
  s3Key            String      @unique
  checksum         String
  sizeBytes        Int
  contentType      String
  width            Int?
  height           Int?
  status           MediaStatus @default(PROCESSING)
  shieldLevel      ShieldLevel @default(WATERMARK_ONLY)
  watermarkPayload String? // ownerId + assetId + horodatage, chiffré
  c2paManifestId   String?
  phash            String? // empreinte perceptuelle — recherche inversée
  createdAt        DateTime    @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workImages   WorkImage[]
  productFiles ProductFile[]

  @@index([ownerId, createdAt])
  @@index([phash])
}

model UploadReservation {
  id           String   @id @default(cuid())
  ownerId      String
  purpose      String
  filename     String
  byteSize     Int
  checksum     String
  s3Key        String   @unique
  presignedUrl String   @db.Text
  expiresAt    DateTime
  status       String   @default("pending") // pending | uploaded | expired
  createdAt    DateTime @default(now())

  @@index([ownerId, status])
}
