// ============================================================================
// BAOBART — Schéma de données
// Source : Doc/BLUEPRINT_NEXTJS_BAOBART.md §4, corrigé et rendu valide.
//
// CORRECTIONS APPORTÉES AU BLUEPRINT :
//   1. `User.profile` était déclaré deux fois (§4.1) → une seule déclaration.
//   2. `ShieldLevel` : `WATERMARK ONLY` → `WATERMARK_ONLY` (4 valeurs, pas 5).
//   3. Toutes les relations ont désormais leurs deux extrémités (exigence Prisma).
//
// CONVENTIONS :
//   - ARGENT : tout montant est un Int, exprimé dans l'unité mineure ISO 4217.
//     Le XOF ayant 0 décimale, « entiers FCFA » = unité mineure. Voir lib/i18n/money.ts.
//   - PAGINATION : index composite (createdAt, id) sur toute table paginée en
//     curseur — jamais d'OFFSET sur les grandes tables (PLAN §8.2).
//   - COMPTEURS : dénormalisés sur le modèle, mis à jour par jobs async.
//   - PORTÉE : les relations sont déclarées sur le graphe chaud (auth, social,
//     commerce, argent). Les modules livrés plus tard (jobs, événements, forum,
//     croissance) portent des FK scalaires indexées ; leurs relations seront
//     déclarées quand le module sera construit.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Connexion applicative. En production elle passe par un pooler
  /// (PgBouncer, Neon, Supabase) : une fonction serverless ouvre une connexion
  /// par invocation, et sans pooler Postgres s'épuise (PLAN §8.2-4).
  url       = env("DATABASE_URL")
  /// Connexion directe, sans pooler, pour les migrations. Un pooler en mode
  /// transaction ne sait pas jouer un `CREATE TYPE` suivi d'un `ALTER TABLE`
  /// dans la même session : les migrations échouent en silence ou à moitié.
  /// En développement, c'est la même URL que ci-dessus.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRiskState {
  NOT_REVIEWED
  COMPLIANT
  ON_PROBATION
  FLAGGED_FRAUD
  FLAGGED_TOS
  SUSPENDED_FRAUD
  SUSPENDED_TOS
}

/// Pouvoir sur la plateforme elle-même — sans rapport avec le chemin
/// acheteur → créateur, qui se déduit de l'activité (voir lib/auth/roles.ts).
/// Un créateur chevronné reste MEMBER ; l'administration ne se mérite pas à
/// l'usage, elle s'accorde.
enum PlatformRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

/// Cinq rôles, pas quatre : le propriétaire est lui aussi une ligne d'équipe
/// (vérifié dans `team_membership.rb`). Sans OWNER, on ne peut pas exprimer
/// « qui possède la boutique » autrement qu'en le devinant.
enum TeamRole {
  OWNER
  ADMIN
  MARKETING
  SUPPORT
  ACCOUNTANT
}

enum ProductType {
  DIGITAL
  BUNDLE
  COMMISSION
  CALL
  COFFEE
  PHYSICAL
  MEMBERSHIP
}

/// Les familles de la barre de filtres du feed, dans l'ordre exact des
/// maquettes (« Baobart Accueil.dc.html », constante FILTERS).
enum ProductFamily {
  ILLUSTRATION
  PHOTO
  MOCKUP
  FONT
  ICONE
  LOGO
  PACK
  ART
  AUDIO
  VIDEO
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// État de la SESSION de paiement (le panier), pas de l'argent.
enum OrderStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// État de l'ARGENT, ligne par ligne. Vérifié dans purchase.rb (state_machine
// purchase_state) : un panier multi-vendeurs produit une charge par vendeur,
// donc une ligne peut réussir pendant qu'une autre échoue.
// `REFUNDED` n'existe volontairement pas : un remboursement est un
// enregistrement Refund distinct, avec son propre montant — c'est ce qui rend
// le remboursement PARTIEL représentable.
enum PurchaseState {
  IN_PROGRESS
  SUCCESSFUL
  FAILED
  NOT_CHARGED // gratuit ou montant nul : livré sans encaissement
}

// État d'un solde journalier. Porté de balance.rb :
//   unpaid → processing → paid,  unpaid → forfeited
// Invariante : les montants ne sont modifiables qu'en état UNPAID.
enum BalanceState {
  UNPAID
  PROCESSING
  PAID
  FORFEITED
}

enum BalanceTransactionType {
  SALE
  COMMISSION
  REFUND
  /// Paiement contesté auprès de la banque : l'argent est repris sans qu'on ait
  /// rien remboursé. Distinct de REFUND, qui est un geste du vendeur.
  CHARGEBACK
  /// Contestation tranchée en faveur du vendeur : l'argent revient.
  CHARGEBACK_REVERSED
  PAYOUT
  AFFILIATE
  POOL
  TIP
}

/// Cycle de vie d'un versement, porté de `payment.rb` (8 états, pas 5).
///
///   CREATING → PROCESSING → COMPLETED
///                   ↓  ↘ UNCLAIMED → COMPLETED
///                   ↓            ↘ CANCELLED
///                   ├→ CANCELLED
///                   ├→ FAILED
///                   ├→ REVERSED
///                   └→ RETURNED        (et COMPLETED → RETURNED : l'argent
///                                       peut revenir APRÈS la réussite)
///
/// RÈGLE À NE PAS PERDRE : un versement qui n'a pas abouti — CANCELLED, FAILED,
/// RETURNED ou REVERSED — remet ses soldes en UNPAID, pour qu'ils soient repris
/// au cycle suivant. Seul COMPLETED les solde.
/// Sans ça, l'argent d'un créateur disparaît d'un versement raté.
enum PayoutStatus {
  CREATING
  PROCESSING
  UNCLAIMED // envoyé, en attente d'action du bénéficiaire
  COMPLETED
  CANCELLED
  FAILED
  RETURNED // revenu (coordonnées invalides, compte fermé)
  REVERSED
}

/// Fréquence choisie par le créateur. Quatre valeurs, pas deux : le §3.9-A
/// ne mentionnait pas le trimestriel.
enum PayoutFrequency {
  DAILY // versement instantané, hors cycle hebdomadaire
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum PayoutMethod {
  BANK
  MOBILE_MONEY
}

enum LicenseCode {
  PERSONAL
  COMMERCIAL
  EXTENDED
}

enum LicenseKeyStatus {
  ACTIVE
  DISABLED
}

enum PlanCode {
  DISCOVERY
  EXPLORER
  STUDIO
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_CANCELLATION
  CANCELLED
  EXPIRED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum ForumRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum BadgeCode {
  VERIFIED_CREATOR
  TOP_CREATOR
  NEW_TALENT
  COMMUNITY_PILLAR
  VIP_CREATOR
}

enum JobType {
  FREELANCE
  CDD
  CDI
  INTERN
  APPRENTICE
}

enum JobMode {
  REMOTE
  HYBRID
  ONSITE
}

enum EventKind {
  CONTEST
  WORKSHOP
  CONFERENCE
  EXHIBITION
}

// Corrigé : « WATERMARK ONLY » du blueprint créait 5 valeurs au lieu de 4.
enum ShieldLevel {
  NONE
  WATERMARK_ONLY
  PERTURBATION
  PERTURBATION_PLUS
}

enum Currency {
  XOF
  NGN
  GHS
  KES
  ZAR
  MAD
  USD
  EUR
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

/// Sept types, pas trois : le §3.9-D n'en voyait que « téléchargement, lecture,
/// stream ». La distinction compte pour les compteurs — télécharger un dossier
/// entier n'est pas télécharger un fichier, et écouter n'est pas lire.
enum ConsumptionType {
  DOWNLOAD
  DOWNLOAD_ALL // « tout télécharger » (ZIP streamé)
  FOLDER_DOWNLOAD
  LISTEN
  READ
  VIEW
  WATCH
}

enum Plateforme {
  ANDROID
  IPHONE
  AUTRE
}

// ============================================================================
// 1. AUTH & UTILISATEURS
// ============================================================================

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  emailVerified   DateTime?
  phone           String?       @unique // mobile money (OTP = mode principal en Afrique)
  passwordHash    String?
  riskState       UserRiskState @default(NOT_REVIEWED) // machine à états §3.8
  kycStatus       KycStatus     @default(NONE)

  /// Accès à l'administration de la plateforme.
  ///
  /// Par défaut MEMBER, et aucun écran ne permet de s'élever : la promotion
  /// passe par `pnpm admin:promouvoir`, donc par quelqu'un qui a déjà la main
  /// sur la base. Une faille dans un formulaire de profil ne doit jamais
  /// pouvoir se terminer en accès administrateur.
  platformRole    PlatformRole  @default(MEMBER)
  /// Coupé automatiquement quand le solde passe sous le seuil bas : un vendeur
  /// criblé de litiges ne peut plus creuser son déficit. Voir lib/domain/trust.ts.
  refundsDisabled Boolean       @default(false)
  defaultCurrency Currency      @default(XOF)

  /// Cadence et rail de versement. Le rail (`wave`, `om`, `mtn`, `bank`…)
  /// détermine le JOUR de la semaine où ce créateur est payé — voir
  /// lib/payments/payout-schedule.ts.
  /// Le mensuel par défaut : un seul virement, donc le moins de frais
  /// d'opérateur. Voir la maquette du panneau de versements.
  payoutFrequency PayoutFrequency @default(MONTHLY)
  payoutRail      String?

  /// Versements suspendus sans que le compte le soit.
  ///
  /// Une enquête en cours, un litige avec un acheteur : on arrête de payer
  /// sans couper la boutique. Confondre les deux obligerait à suspendre un
  /// créateur — donc à retirer ses produits de la vente — pour retenir un
  /// virement, ce qui est disproportionné (`payouts_paused?` chez Gumroad).
  payoutsPausedAt     DateTime?
  payoutsPausedReason String?

  /// Compteurs dénormalisés du suivi. La maquette les affiche partout —
  /// en-tête de profil, tableau de bord, carte créateur — et un COUNT() par
  /// affichage sur une table qui grossit sans fin ne tiendrait pas (PLAN §8.2).
  followersCount Int @default(0)
  followingCount Int @default(0)

  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // identité
  profile        Profile?
  billing        BillingInfo?
  payoutAccounts PayoutAccount[]
  accounts Account[]
  sessions Session[]
  passkeys Passkey[]
  passwordResets PasswordReset[]

  // équipes multi-rôles (§3.10-B)
  memberships TeamMembership[] @relation("TeamMember")
  teamSeats   TeamMembership[] @relation("TeamSeller")

  // social visuel
  workItems WorkItem[]
  boards    Board[]
  likes     Like[]
  comments  Comment[]
  following Follow[]   @relation("Follower")
  followers Follow[]   @relation("Following")

  // commerce
  products Product[]
  orders   Order[]
  cart     Cart?

  // argent
  balances            Balance[]
  balanceTransactions BalanceTransaction[]
  payouts             Payout[]
  mobileMoneyAccounts MobileMoneyAccount[]

  // monétisation & réputation
  subscriptions Subscription[]
  badges        UserBadge[]

  // communauté
  communityMemberships CommunityMembership[]

  // médias & notifications
  mediaAssets   MediaAsset[]
  notifications Notification[]

  // confiance
  riskStateChanges RiskStateChange[]

  @@index([riskState])
  @@index([platformRole])
  @@index([createdAt, id])
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  username      String  @unique
  displayName   String
  bio           String? @db.Text
  city          String?
  country       String? // ISO 3166-1 alpha-2
  avatarUrl     String?
  bannerUrl     String?
  isVerified    Boolean @default(false) // badge « Créateur vérifié »
  // compteurs dénormalisés (§3.9-H : jamais d'AVG() ni de COUNT() live)
  ratingAvg     Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)
  workCount     Int     @default(0)
  followerCount Int     @default(0)

  /// Vitrine du créateur — écran « Profil public » du tableau de bord.
  /// Tous facultatifs : un acheteur n'a aucune raison de les remplir.
  speciality        String?
  portfolioUrl      String?
  instagram         String?
  behance           String?
  /// Texte libre plutôt qu'un booléen : la maquette attend « Oui, sous
  /// 2 semaines », qui dit à la fois la disponibilité et le délai.
  openToCommissions String?
  /// Tarif journalier indicatif, en unité mineure XOF comme tout montant.
  dailyRate         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

/// Informations de facturation.
///
/// Séparées de `Profile` À DESSEIN : le profil est public, ceci ne l'est pas.
/// Les mélanger ferait qu'un `select` distrait sur le profil exposerait
/// l'adresse postale de quelqu'un. L'écran « Profil » du tableau de bord
/// acheteur les présente ensemble, mais c'est une vue, pas un modèle.
/// Où envoyer l'argent d'un créateur.
///
/// Un modèle à part, pas un champ sur `User` : un numéro de mobile money
/// change, et savoir QUAND il a changé est ce qui permet de repérer le schéma
/// classique — changer le numéro juste avant un versement. Gumroad garde de
/// même l'historique de ses comptes bancaires.
model PayoutAccount {
  id      String       @id @default(cuid())
  userId  String
  method  PayoutMethod
  /// Rail d'acheminement : `wave`, `om`, `mtn`, `moov`, `bank`. C'est lui qui
  /// décide du jour de la semaine où ce créateur est payé.
  provider String
  /// Numéro mobile money ou identifiant bancaire.
  accountRef String
  /// Nom du titulaire, tel que l'opérateur le connaît. Un écart avec le nom du
  /// compte est le premier motif de rejet d'un virement.
  holderName String?

  /// Vérifié par un contrôle d'identité. Enregistré mais **pas encore exigé** :
  /// aucun KYC n'existe, et l'exiger aujourd'hui ne paierait personne. À rendre
  /// obligatoire le jour où le contrôle sera en place.
  verifiedAt DateTime?

  /// Compte retiré. Jamais supprimé : un versement passé le référence, et son
  /// historique doit rester lisible.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model BillingInfo {
  id           String  @id @default(cuid())
  userId       String  @unique
  firstName    String?
  lastName     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  /// ISO 3166-1 alpha-2.
  country      String?
  region       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamMembership {
  id        String    @id @default(cuid())
  memberId  String
  sellerId  String
  role      TeamRole
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  member User @relation("TeamMember", fields: [memberId], references: [id], onDelete: Cascade)
  seller User @relation("TeamSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([memberId, sellerId])
  @@index([sellerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // google | github | apple | discord | phone…
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Demande de réinitialisation de mot de passe.
///
/// La table ne garde que l'**empreinte** du jeton, comme pour les sessions :
/// une fuite ne permet donc pas de prendre la main sur un compte. SHA-256
/// suffit là où les mots de passe exigent scrypt — un jeton de 32 octets tirés
/// au hasard n'est pas devinable, il n'y a rien à ralentir.
/// Sort d'un appel entrant d'opérateur.
enum WebhookEventStatus {
  /// Reçu et authentifié, pas encore traité.
  RECEIVED
  /// Traité : la commande a bougé.
  PROCESSED
  /// Authentique, mais sans effet — l'état visé était déjà atteint. C'est le
  /// cas normal d'un rejeu, pas une anomalie.
  IGNORED
  /// Signature invalide, corps illisible, ou commande introuvable.
  REJECTED
}

/// Un appel entrant d'un opérateur de paiement.
///
/// ──────────────────────────────────────────────────────────────────────────
/// POURQUOI CETTE TABLE EXISTE
///
/// Un opérateur rejoue ses appels. Sur incident réseau, sur dépassement de
/// délai, et parfois sans raison apparente. Sans trace, un rejeu crédite deux
/// fois le vendeur pour une seule vente — et l'écart ne se voit qu'au moment
/// de verser, des semaines plus tard.
///
/// La clé d'unicité porte donc sur `(provider, eventRef)` : deux appels
/// portant la même référence sont le même fait, et le second ne fait rien.
///
/// ON GARDE AUSSI LES APPELS REFUSÉS. C'est un arbitrage : la route est
/// publique, donc chaque refus enregistré est une écriture qu'un inconnu
/// provoque. On l'accepte parce que la panne la plus fréquente d'une
/// intégration est un secret mal recopié — et que sans ces lignes, elle est
/// parfaitement silencieuse. Le `eventRef` d'un appel refusé est l'empreinte
/// de son corps : un même corps rejoué mille fois n'écrit qu'une ligne.
model PaymentWebhookEvent {
  id String @id @default(cuid())

  /// L'opérateur qui a appelé.
  provider String
  /// Ce que l'opérateur appelle cet événement. Pour un refus : l'empreinte du
  /// corps reçu, faute de pouvoir en croire le contenu.
  eventRef String

  /// La référence de la transaction chez l'opérateur, quand on a pu la lire.
  providerRef String?

  /// Le corps reçu, tel quel. Il ne sert pas à décider — il sert le jour où
  /// l'opérateur conteste ce qu'il affirme avoir envoyé.
  payload Json

  status WebhookEventStatus @default(RECEIVED)
  /// Pourquoi il a été refusé, ou ce qui a échoué au traitement.
  error  String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventRef])
  @@index([status, receivedAt])
  @@index([providerRef])
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String
  token  String @unique

  /// Court : une heure. Un lien de réinitialisation est un mot de passe
  /// temporaire qui traîne dans une boîte mail.
  expiresAt DateTime

  /// Consommé. Le jeton ne sert qu'une fois : sans cela, quiconque relit le
  /// courriel un mois plus tard reprend la main sur le compte.
  usedAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      Int      @default(0)
  label        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// 2. SOCIAL VISUEL — le cœur Pinterest × Dribbble
// ============================================================================

model WorkItem {
  id            String         @id @default(cuid())
  authorId      String
  title         String
  caption       String?        @db.Text
  coverImageId  String?
  status        WorkItemStatus @default(PUBLISHED)
  shieldLevel   ShieldLevel    @default(WATERMARK_ONLY)
  likesCount    Int            @default(0)
  commentsCount Int            @default(0)
  savesCount    Int            @default(0)
  viewsCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   WorkImage[]
  tags     WorkItemTag[]
  likes    Like[]
  comments Comment[]
  saves    Save[]
  product  Product?

  @@index([status, createdAt, id]) // pagination curseur du feed
  @@index([authorId, createdAt])
}

model WorkImage {
  id         String @id @default(cuid())
  workItemId String
  mediaId    String
  variant    String @default("original") // original | preview | thumb
  width      Int?
  height     Int?
  position   Int    @default(0)

  workItem WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([workItemId])
  @@index([mediaId])
}

model Tag {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  usesCount Int           @default(0)
  workItems WorkItemTag[]
  products  ProductTag[]
}

/// Mots-clés d'une ressource vendable.
///
/// Les shots avaient déjà les leurs (`WorkItemTag`) ; l'écran « Publier une
/// ressource » en demande aussi, et il n'y avait rien pour les recevoir.
model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model WorkItemTag {
  workItemId String
  tagId      String

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workItemId, tagId])
  @@index([tagId])
}

/// Un like porte soit sur un shot du portfolio, soit sur une ressource vendable.
/// Même forme polymorphe que `Save`, pour la même raison : une ressource déposée
/// par le formulaire « Publier » n'a pas de `WorkItem`, et lui en fabriquer un
/// fantôme pour pouvoir l'aimer serait un détour coûteux.
/// Une contrainte SQL impose qu'exactement une des deux cibles soit renseignée —
/// ce que Prisma ne sait pas exprimer.
model Like {
  id         String   @id @default(cuid())
  userId     String
  workItemId String?
  productId  String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, workItemId])
  @@unique([userId, productId])
  @@index([workItemId])
  @@index([productId])
  @@index([userId, createdAt])
}

/// Même polymorphisme que `Like` : on commente un shot ou une ressource.
model Comment {
  id         String   @id @default(cuid())
  authorId   String
  workItemId String?
  productId  String?
  parentId   String? // réponses threadées
  body       String   @db.Text
  likesCount Int      @default(0)
  isFlagged  Boolean  @default(false)
  /// Un commentaire retiré laisse sa place dans le fil : effacer la ligne
  /// emporterait les réponses qui s'y accrochent.
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  @@index([workItemId, createdAt])
  @@index([productId, createdAt])
  @@index([authorId])
}

model Board {
  id           String   @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  isPublic     Boolean  @default(true)
  coverImageId String?
  savesCount   Int      @default(0)
  createdAt    DateTime @default(now())

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  saves Save[]

  @@index([ownerId])
}

model Save {
  id         String   @id @default(cuid())
  boardId    String
  workItemId String?
  productId  String?
  createdAt  DateTime @default(now())

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([boardId, workItemId])
  @@unique([boardId, productId])
  @@index([workItemId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ============================================================================
// 3. COMMERCE (logique portée de Gumroad — spécification MIT)
// ============================================================================

model Product {
  id            String         @id @default(cuid())
  sellerId      String
  workItemId    String?        @unique // le shot devient vendable
  slug          String         @unique
  name          String
  description   String?        @db.Text
  coverImageId  String?
  type          ProductType    @default(DIGITAL)
  /// Famille affichée dans la barre de filtres du feed.
  family        ProductFamily?
  status        ProductStatus  @default(DRAFT)
  /// URL CDN de la couverture, dénormalisée : le feed en affiche des dizaines
  /// par page et ne doit pas résoudre un MediaAsset par carte (PLAN §8.2).
  coverUrl      String?
  /// Extrait public écoutable ou visionnable, pour ce qu'une image ne montre
  /// pas : une nappe sonore, un motion design. Déposé par le créateur — on ne
  /// transcode rien.
  previewUrl    String?
  /// « audio » ou « video » : décide du lecteur à poser sur la fiche.
  previewKind   String?
  price         Int // unité mineure — voir lib/i18n/money.ts
  currency      Currency       @default(XOF)
  licenseTypeId String?

  // découverte
  isStaffPicked          Boolean   @default(false) // sélection éditoriale §3.10-A
  staffPickedAt          DateTime?
  isBoosted              Boolean   @default(false) // boost payant §10.9
  discoverFeePerThousand Int?

  // compteurs dénormalisés
  salesCount     Int     @default(0)
  downloadsCount Int     @default(0)
  likesCount     Int     @default(0)
  commentsCount  Int     @default(0)
  ratingAvg      Decimal @default(0) @db.Decimal(3, 2)
  ratingCount    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  workItem    WorkItem?     @relation(fields: [workItemId], references: [id])
  licenseType LicenseType?  @relation(fields: [licenseTypeId], references: [id])
  files       ProductFile[]
  tags        ProductTag[]
  variants    Variant[]
  orderItems  OrderItem[]
  saves       Save[]
  likes       Like[]
  comments    Comment[]

  @@index([status, createdAt, id]) // curseur feed
  @@index([status, family, createdAt, id]) // curseur feed filtré par famille
  @@index([sellerId, status])
  @@index([isStaffPicked, staffPickedAt])
}

/// Deux natures de fichier, pas une. Le fichier source est ce que l'acheteur
/// reçoit : il reste privé, derrière une URL signée. L'aperçu est ce que tout
/// le monde voit : il vit sous le préfixe public du stockage. Les confondre
/// rendrait le payant téléchargeable gratuitement.
enum ProductFileRole {
  SOURCE
  PREVIEW
}

model ProductFile {
  id        String          @id @default(cuid())
  productId String
  mediaId   String
  filename  String
  sizeBytes Int
  role      ProductFileRole @default(SOURCE)
  position  Int             @default(0)
  /// Retiré d'une ressource **déjà vendue** : la ligne et l'objet au stockage
  /// restent. Un retrait par erreur serait sinon irrécupérable, et ce sont des
  /// acheteurs qui auraient payé pour rien. Reprend le `Deletable` de Gumroad —
  /// qui ne sert pas non plus un fichier retiré, mais n'en détruit jamais les
  /// octets. Sur un brouillon jamais vendu, la ligne part pour de bon.
  deletedAt DateTime?
  createdAt DateTime        @default(now())

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([productId, role, deletedAt])
  @@index([mediaId])
}

model Variant {
  id         String @id @default(cuid())
  productId  String
  name       String
  priceDelta Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  items     Json     @default("[]") // [{productId, variantId, qty}]
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  status      OrderStatus @default(IN_PROGRESS)
  total       Int
  currency    Currency    @default(XOF)
  provider    String? // flutterwave | paystack | cinetpay | stripe
  providerRef String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

/// Une ligne d'achat = un produit d'un vendeur. C'est ici que vit l'état de
/// l'argent (équivalent de `Purchase` chez Gumroad), et non sur la commande :
/// un panier multi-vendeurs génère une charge par vendeur, dont l'une peut
/// échouer sans annuler les autres.
model OrderItem {
  id        String        @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int           @default(1)
  state     PurchaseState @default(IN_PROGRESS)

  // Décomposition BRUT → NET, figée au moment de la vente. Le net est ce qui
  // alimente le solde du vendeur : net = price × quantity − les quatre parts.
  price        Int // prix unitaire encaissé
  platformFee  Int @default(0) // commission Baobart (§2.4 — 10 % ou 20 %, non tranché)
  processorFee Int @default(0) // mobile money / carte
  affiliateFee Int @default(0) // part de l'affilié (§10.1)
  taxAmount    Int @default(0)

  /// Cumul remboursé, dénormalisé depuis Refund. Permet le remboursement
  /// PARTIEL, qu'un simple statut « remboursé » ne sait pas exprimer.
  refundedAmount Int @default(0)

  /// Paiement contesté auprès de la banque ou de l'opérateur : l'argent est
  /// repris sans qu'on ait rien remboursé. Distinct du remboursement, qui est
  /// un geste du vendeur (url_redirects_controller.rb §295 chez Gumroad).
  chargebackAt         DateTime?
  /// Contestation tranchée en faveur du vendeur : l'accès revient.
  chargebackReversedAt DateTime?

  /// Accès coupé à la main par le vendeur — revente en masse, abus. Séparé du
  /// remboursement : on peut retirer l'accès sans rendre l'argent, et rendre
  /// l'argent sans retirer l'accès.
  accessRevokedAt DateTime?

  createdAt DateTime @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  variant    Variant?    @relation(fields: [variantId], references: [id])
  licenseKey LicenseKey?
  refunds    Refund[]

  @@index([orderId])
  @@index([productId])
  @@index([state, createdAt])
  /// Les litiges ouverts se balayent par cette colonne (livraison, supervision).
  @@index([chargebackAt])
}

/// Un remboursement est un ENREGISTREMENT, pas un statut (vérifié : `refunded`
/// n'est pas un état de `purchase_state` chez Gumroad ; les remboursements sont
/// des lignes `Refund` avec leur propre montant). Plusieurs remboursements
/// partiels peuvent s'empiler sur la même ligne d'achat.
model Refund {
  id           String   @id @default(cuid())
  orderItemId  String
  amount       Int
  currency     Currency @default(XOF)
  reason       String?
  processorRef String?
  refundedById String? // null = automatique (politique, litige)

  /// Commission que la plateforme a gardée sur ce remboursement.
  ///
  /// Politique arrêtée : la commission n'est pas rendue, et les frais
  /// d'opérateur restent à la charge du vendeur — c'est donc lui qui finance
  /// le remboursement en entier. Ce champ n'entre dans aucun calcul : il note
  /// ce que Baobart a conservé, faute d'un compte plateforme au grand livre.
  retainedFee  Int      @default(0)
  createdAt    DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([createdAt])
}

// ============================================================================
// 4. ARGENT — soldes, transactions, payouts
// ============================================================================

/// Solde JOURNALIER d'un vendeur, pas un solde unique.
///
/// Porté de `balance.rb` : une ligne par (vendeur, jour, devise de détention).
/// C'est ce découpage par jour qui rend le versement par lot possible — sans
/// lui, impossible de répondre « voici exactement ce qui part mercredi ».
///
/// INVARIANTE : `amount` et `holdingAmount` ne sont modifiables qu'en état
/// UNPAID. Une fois le solde passé en PROCESSING, il est figé — c'est ce qui
/// empêche une vente tardive de modifier un versement déjà en cours.
/// À faire respecter dans `lib/domain/balances.ts` ET par un trigger Postgres.
model Balance {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  /// Devise d'encaissement et montant net collecté ce jour-là.
  currency Currency @default(XOF)
  amount   Int      @default(0)

  /// Devise de DÉTENTION : ce que Baobart doit réellement au créateur.
  /// Pour les fonds détenus par Baobart c'est toujours le XOF — la dette est
  /// libellée dans la devise de versement, jamais dans celle de l'acheteur.
  holdingCurrency Currency @default(XOF)
  holdingAmount   Int      @default(0)

  state     BalanceState @default(UNPAID)
  payoutId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  payout       Payout?              @relation(fields: [payoutId], references: [id])
  transactions BalanceTransaction[]

  @@unique([userId, date, holdingCurrency])
  @@index([state, date]) // sélection des soldes à verser
  @@index([userId, state])
}

/// Grand livre IMMUABLE : une ligne par mouvement d'argent.
/// Montant positif = crédit au solde, négatif = débit. Jamais de UPDATE ni de
/// DELETE — une erreur se corrige par une écriture inverse.
///
/// Les SIX colonnes monétaires viennent de `balance_transactions` (vérifié dans
/// db/schema.rb) et ne sont pas un luxe : un acheteur de la diaspora paie en
/// EUR pendant que le créateur d'Abidjan est crédité en XOF. Avec un montant
/// unique, on perd soit le montant réellement encaissé, soit la dette réelle.
///   - issued*  : ce qui a été encaissé, dans la devise de l'acheteur
///   - holding* : ce que Baobart doit au vendeur, dans sa devise de versement
///   - gross    : avant frais, taxes et part d'affiliation
///   - net      : après — c'est le net qui alimente le solde
model BalanceTransaction {
  id         String                 @id @default(cuid())
  userId     String
  balanceId  String
  type       BalanceTransactionType
  occurredAt DateTime               @default(now())

  issuedCurrency Currency
  issuedGross    Int
  issuedNet      Int

  holdingCurrency Currency
  holdingGross    Int
  holdingNet      Int

  /// Origine du mouvement — exactement une de ces références est renseignée.
  orderItemId String?
  refundId    String?
  payoutId    String?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance Balance @relation(fields: [balanceId], references: [id])
  payout  Payout? @relation(fields: [payoutId], references: [id])

  @@index([userId, occurredAt])
  @@index([balanceId])
  @@index([orderItemId])
}

model Payout {
  id            String       @id @default(cuid())
  userId        String
  method        PayoutMethod
  provider      String // om | mtn | wave | moov | bank | stripe
  accountRef    String
  amount        Int
  currency      Currency     @default(XOF)
  status        PayoutStatus @default(CREATING)
  scheduledDate DateTime? // le jour où le créateur reçoit l'argent
  /// Le cycle auquel ce versement appartient — c'est LUI qui décide quelles
  /// ventes sont incluses, pas `scheduledDate`. Deux créateurs de rails
  /// différents payés des jours différents partagent le même cycle et donc
  /// la même période de ventes. Confondre les deux fait sauter des créateurs
  /// d'un lot entier. Voir lib/payments/payout-schedule.ts.
  cycleDate     DateTime?    @db.Date
  /// Dernière date de vente incluse (cycle − délai de rétention).
  periodEnd     DateTime?    @db.Date
  processedAt   DateTime?
  isInstant     Boolean      @default(false)
  /// Référence rendue par l'opérateur. C'est elle qui permet de retrouver
  /// l'ordre chez lui le jour où le créateur dit n'avoir rien reçu — sans
  /// elle, une réclamation n'a aucune prise.
  providerRef   String?
  failureReason String?
  createdAt     DateTime     @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  balances     Balance[]
  transactions BalanceTransaction[]

  @@index([userId, status])
  @@index([status, scheduledDate])
  /// Réconciliation : retrouver un versement depuis la référence de l'opérateur.
  @@index([providerRef])
}

model MobileMoneyAccount {
  id         String    @id @default(cuid())
  userId     String
  provider   String // om | mtn | moov | wave
  phone      String
  country    String
  verifiedAt DateTime?
  kycStatus  KycStatus @default(NONE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model ExchangeRate {
  id   String   @id @default(cuid())
  from Currency
  to   Currency
  rate Decimal  @db.Decimal(18, 8)
  date DateTime @default(now()) @db.Date

  @@unique([from, to, date])
}

// ============================================================================
// 5. MONÉTISATION & LICENCES
// ============================================================================

model Plan {
  id                String       @id @default(cuid())
  code              PlanCode     @unique
  name              String
  priceMonthly      Int // unité mineure XOF
  downloadsPerMonth Int? // null = illimité (Studio)
  licenseIncluded   LicenseCode?
  shieldLevel       ShieldLevel  @default(NONE)
  features          Json         @default("{}")

  subscriptions Subscription[]
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  cycleStart      DateTime           @default(now())
  cycleEnd        DateTime
  paymentProvider String?
  providerRef     String?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan            @relation(fields: [planId], references: [id])
  quotas DownloadQuota[]

  @@index([userId, status])
  @@index([status, cycleEnd])
}

model DownloadQuota {
  id             String @id @default(cuid())
  subscriptionId String
  period         String // « 2026-08 »
  used           Int    @default(0)
  limit          Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
}

/// Chaque consommation d'un fichier laisse une ligne. C'est ce qui alimente le
/// compteur « 2 340 téléchargements » de la maquette, l'analytique créateur, et
/// le décompte des quotas d'abonnement.
model ConsumptionEvent {
  id            String          @id @default(cuid())
  userId        String?
  productId     String
  productFileId String?
  orderItemId   String?
  eventType     ConsumptionType
  platform      Plateforme      @default(AUTRE)
  ipAddress     String?
  consumedAt    DateTime        @default(now())

  @@index([productId, consumedAt])
  @@index([userId, consumedAt])
  @@index([orderItemId])
}

model LicenseType {
  id           String      @id @default(cuid())
  code         LicenseCode @unique
  title        String
  description  String      @db.Text
  conditions   Json        @default("{}") // print, edition, broadcast, merchandising…
  pricePremium Int? // licence étendue payante

  products Product[]
}

model LicenseKey {
  id          String           @id @default(cuid())
  productId   String
  orderItemId String           @unique
  serial      String           @unique // XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX
  status      LicenseKeyStatus @default(ACTIVE)
  usesCount   Int              @default(0)
  disabledAt  DateTime?
  createdAt   DateTime         @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model RevenuePool {
  id            String    @id @default(cuid())
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Int
  creatorsShare Int // 60-70 % redistribué (§2.4)
  distributedAt DateTime?

  allocations RevenuePoolAllocation[]

  @@unique([periodStart, periodEnd])
}

model RevenuePoolAllocation {
  id             String @id @default(cuid())
  poolId         String
  userId         String
  amount         Int
  downloadsCount Int

  pool RevenuePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([userId])
}

