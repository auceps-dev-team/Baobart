// ============================================================================
// BAOBART — Schéma de données
// Source : Doc/BLUEPRINT_NEXTJS_BAOBART.md §4, corrigé et rendu valide.
//
// CORRECTIONS APPORTÉES AU BLUEPRINT :
//   1. `User.profile` était déclaré deux fois (§4.1) → une seule déclaration.
//   2. `ShieldLevel` : `WATERMARK ONLY` → `WATERMARK_ONLY` (4 valeurs, pas 5).
//   3. Toutes les relations ont désormais leurs deux extrémités (exigence Prisma).
//
// CONVENTIONS :
//   - ARGENT : tout montant est un Int, exprimé dans l'unité mineure ISO 4217.
//     Le XOF ayant 0 décimale, « entiers FCFA » = unité mineure. Voir lib/i18n/money.ts.
//   - PAGINATION : index composite (createdAt, id) sur toute table paginée en
//     curseur — jamais d'OFFSET sur les grandes tables (PLAN §8.2).
//   - COMPTEURS : dénormalisés sur le modèle, mis à jour par jobs async.
//   - PORTÉE : les relations sont déclarées sur le graphe chaud (auth, social,
//     commerce, argent). Les modules livrés plus tard (jobs, événements, forum,
//     croissance) portent des FK scalaires indexées ; leurs relations seront
//     déclarées quand le module sera construit.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Connexion applicative. En production elle passe par un pooler
  /// (PgBouncer, Neon, Supabase) : une fonction serverless ouvre une connexion
  /// par invocation, et sans pooler Postgres s'épuise (PLAN §8.2-4).
  url       = env("DATABASE_URL")
  /// Connexion directe, sans pooler, pour les migrations. Un pooler en mode
  /// transaction ne sait pas jouer un `CREATE TYPE` suivi d'un `ALTER TABLE`
  /// dans la même session : les migrations échouent en silence ou à moitié.
  /// En développement, c'est la même URL que ci-dessus.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRiskState {
  NOT_REVIEWED
  COMPLIANT
  ON_PROBATION
  FLAGGED_FRAUD
  FLAGGED_TOS
  SUSPENDED_FRAUD
  SUSPENDED_TOS
}

/// Pouvoir sur la plateforme elle-même — sans rapport avec le chemin
/// acheteur → créateur, qui se déduit de l'activité (voir lib/auth/roles.ts).
/// Un créateur chevronné reste MEMBER ; l'administration ne se mérite pas à
/// l'usage, elle s'accorde.
/// Ce qu'une personne a le droit de faire sur la plateforme.
///
/// ──────────────────────────────────────────────────────────────────────────
/// UN SEUL RÔLE PAR PERSONNE, ET C'EST LA SPEC QUI LE VEUT
///
/// `SPEC_ADMIN_CMS_BAOBART.md` §2 décrit un champ `role` unique. Un jeu de
/// rôles cumulables serait plus souple et plus lourd : il faudrait une table de
/// liaison, une union de pouvoirs, et une page pour la tenir. Quelqu'un qui a
/// besoin de deux fonctions reçoit ADMIN, qui les couvre toutes sauf la
/// distribution des pouvoirs.
///
/// ──────────────────────────────────────────────────────────────────────────
/// AUCUN N'EST HÉRITÉ
///
/// Les pouvoirs de chaque rôle sont écrits en entier dans
/// `lib/auth/administration.ts`. Écrire « SUPER_ADMIN hérite d'ADMIN »
/// économiserait trois lignes et coûterait la relecture.
enum PlatformRole {
  MEMBER

  /// Rédaction et publication éditoriale : articles, événements.
  CONTENT_MANAGER
  /// Sponsoring, mise en avant, infolettres.
  MARKETING
  /// Files de modération : offres, services, contenus signalés.
  MODERATOR
  /// Tickets, litiges, remboursements.
  SUPPORT
  /// Versements, soldes, rapports.
  ACCOUNTANT
  /// KYC, états de risque, juridique.
  COMPLIANCE

  /// Le généraliste : tout, sauf distribuer les pouvoirs.
  ADMIN
  /// Tout, y compris nommer et révoquer.
  SUPER_ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

/// Cinq rôles, pas quatre : le propriétaire est lui aussi une ligne d'équipe
/// (vérifié dans `team_membership.rb`). Sans OWNER, on ne peut pas exprimer
/// « qui possède la boutique » autrement qu'en le devinant.
enum TeamRole {
  OWNER
  ADMIN
  MARKETING
  SUPPORT
  ACCOUNTANT
}

enum ProductType {
  DIGITAL
  BUNDLE
  COMMISSION
  CALL
  COFFEE
  PHYSICAL
  MEMBERSHIP
}

/// Les familles de la barre de filtres du feed, dans l'ordre exact des
/// maquettes (« Baobart Accueil.dc.html », constante FILTERS).
enum ProductFamily {
  ILLUSTRATION
  PHOTO
  MOCKUP
  FONT
  ICONE
  LOGO
  PACK
  ART
  AUDIO
  VIDEO
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  /// Retirée par la plateforme sur notification juridique (loi 2013-451,
  /// art. 46). Distincte d'ARCHIVED, qui est un geste du créateur ou une
  /// sanction de compte : lui seul ne peut pas la lever, et `LegalSuspension`
  /// garde l'état à rendre si le dossier se solde par une remise en ligne.
  SUSPENDED
}

enum WorkItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// État de la SESSION de paiement (le panier), pas de l'argent.
/// Comment le prix d'une ressource se decide.
///
/// ============================================================================
/// DEUX LIGNES DE LA MATRICE, UN SEUL MECANISME
///
/// « Pourboires » et « produits coffee » (§3.4-B et §3.4-D) demandent la meme
/// chose : que l'acheteur choisisse le montant. Les traiter separement aurait
/// donne deux chemins d'encaissement paralleles a tenir en phase.
///
/// `LIBRE` couvre le produit « coffee » — soutiens l'auteur, choisis combien.
/// Le pourboire, lui, s'ajoute a un prix fixe : c'est `Product.tipsEnabled`
/// et `OrderItem.tipAmount`, sur le meme calcul de frais.
enum PricingMode {
  /// Le createur fixe le prix. Comportement de toutes les ressources jusqu'ici.
  FIXED
  /// L'acheteur choisit, au-dessus d'un plancher.
  LIBRE
}

enum OrderStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// État de l'ARGENT, ligne par ligne. Vérifié dans purchase.rb (state_machine
// purchase_state) : un panier multi-vendeurs produit une charge par vendeur,
// donc une ligne peut réussir pendant qu'une autre échoue.
// `REFUNDED` n'existe volontairement pas : un remboursement est un
// enregistrement Refund distinct, avec son propre montant — c'est ce qui rend
// le remboursement PARTIEL représentable.
enum PurchaseState {
  IN_PROGRESS
  SUCCESSFUL
  FAILED
  NOT_CHARGED // gratuit ou montant nul : livré sans encaissement
}

// État d'un solde journalier. Porté de balance.rb :
//   unpaid → processing → paid,  unpaid → forfeited
// Invariante : les montants ne sont modifiables qu'en état UNPAID.
enum BalanceState {
  UNPAID
  PROCESSING
  PAID
  FORFEITED
}

enum BalanceTransactionType {
  SALE
  COMMISSION
  REFUND
  /// Paiement contesté auprès de la banque : l'argent est repris sans qu'on ait
  /// rien remboursé. Distinct de REFUND, qui est un geste du vendeur.
  CHARGEBACK
  /// Contestation tranchée en faveur du vendeur : l'argent revient.
  CHARGEBACK_REVERSED
  PAYOUT
  AFFILIATE
  POOL
  TIP
}

/// Cycle de vie d'un versement, porté de `payment.rb` (8 états, pas 5).
///
///   CREATING → PROCESSING → COMPLETED
///                   ↓  ↘ UNCLAIMED → COMPLETED
///                   ↓            ↘ CANCELLED
///                   ├→ CANCELLED
///                   ├→ FAILED
///                   ├→ REVERSED
///                   └→ RETURNED        (et COMPLETED → RETURNED : l'argent
///                                       peut revenir APRÈS la réussite)
///
/// RÈGLE À NE PAS PERDRE : un versement qui n'a pas abouti — CANCELLED, FAILED,
/// RETURNED ou REVERSED — remet ses soldes en UNPAID, pour qu'ils soient repris
/// au cycle suivant. Seul COMPLETED les solde.
/// Sans ça, l'argent d'un créateur disparaît d'un versement raté.
enum PayoutStatus {
  CREATING
  PROCESSING
  UNCLAIMED // envoyé, en attente d'action du bénéficiaire
  COMPLETED
  CANCELLED
  FAILED
  RETURNED // revenu (coordonnées invalides, compte fermé)
  REVERSED
}

/// Fréquence choisie par le créateur. Quatre valeurs, pas deux : le §3.9-A
/// ne mentionnait pas le trimestriel.
enum PayoutFrequency {
  DAILY // versement instantané, hors cycle hebdomadaire
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum PayoutMethod {
  BANK
  MOBILE_MONEY
}

enum LicenseCode {
  PERSONAL
  COMMERCIAL
  EXTENDED
}

enum LicenseKeyStatus {
  ACTIVE
  DISABLED
}

enum PlanCode {
  DISCOVERY
  EXPLORER
  STUDIO
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_CANCELLATION
  CANCELLED
  EXPIRED
}

/// Où en est UN paiement d'abonnement.
///
/// Trois états seulement, là où une commande en a huit. Un abonnement ne se
/// livre pas, ne se conteste pas auprès d'un vendeur, et ne se rembourse pas
/// partiellement : il n'y a rien à modéliser de plus. Ajouter des états « au
/// cas où » fabriquerait des transitions que personne n'écrit et que personne
/// ne teste.
enum SubscriptionPaymentStatus {
  /// Ouvert chez l'opérateur. L'abonné n'a encore rien validé.
  PENDING
  /// L'argent est arrivé, et le cycle a été avancé.
  PAID
  /// Refusé, interrompu, ou périmé sans réponse.
  FAILED
}

/// À quel rythme un abonnement se renouvelle.
///
/// Porté par l'abonnement et non par l'offre : deux abonnés d'un même plan
/// peuvent choisir des rythmes différents, et le prix annuel n'est presque
/// jamais douze fois le mensuel.
enum Cadence {
  HEBDOMADAIRE
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum ForumRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum BadgeCode {
  VERIFIED_CREATOR
  TOP_CREATOR
  NEW_TALENT
  COMMUNITY_PILLAR
  VIP_CREATOR
  /// Créateur indépendant, accordé par l'administration après vérification.
  /// Ouvre le droit de publier sur le CMS Services, à condition d'être
  /// vendeur et abonné (voir `lib/cms/droits.ts` §services).
  /// **S'exclut de `AGENCE`** — l'exclusivité vit dans `lib/services/badges.ts`,
  /// pas dans le schéma : une contrainte SQL demanderait de connaître les
  /// identifiants des badges, qui ne sont pas les codes.
  FREELANCE
  /// Structure de plusieurs personnes, même règle et même exclusivité.
  AGENCE
}

enum JobType {
  FREELANCE
  CDD
  CDI
  INTERN
  APPRENTICE
}

enum JobMode {
  REMOTE
  HYBRID
  ONSITE
}

enum EventKind {
  CONTEST
  WORKSHOP
  CONFERENCE
  EXHIBITION
}

// Corrigé : « WATERMARK ONLY » du blueprint créait 5 valeurs au lieu de 4.
enum ShieldLevel {
  NONE
  WATERMARK_ONLY
  PERTURBATION
  PERTURBATION_PLUS
}

enum Currency {
  XOF
  NGN
  GHS
  KES
  ZAR
  MAD
  USD
  EUR
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

/// Sept types, pas trois : le §3.9-D n'en voyait que « téléchargement, lecture,
/// stream ». La distinction compte pour les compteurs — télécharger un dossier
/// entier n'est pas télécharger un fichier, et écouter n'est pas lire.
enum ConsumptionType {
  DOWNLOAD
  DOWNLOAD_ALL // « tout télécharger » (ZIP streamé)
  FOLDER_DOWNLOAD
  LISTEN
  READ
  VIEW
  WATCH
}

enum Plateforme {
  ANDROID
  IPHONE
  AUTRE
}

// ============================================================================
// 1. AUTH & UTILISATEURS
// ============================================================================

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  phone         String?       @unique // mobile money (OTP = mode principal en Afrique)
  passwordHash  String?
  riskState     UserRiskState @default(NOT_REVIEWED) // machine à états §3.8
  kycStatus     KycStatus     @default(NONE)

  /// Accès à l'administration de la plateforme.
  ///
  /// Par défaut MEMBER, et aucun écran ne permet de s'élever : la promotion
  /// passe par `pnpm admin:promouvoir`, donc par quelqu'un qui a déjà la main
  /// sur la base. Une faille dans un formulaire de profil ne doit jamais
  /// pouvoir se terminer en accès administrateur.
  platformRole    PlatformRole @default(MEMBER)
  /// Coupé automatiquement quand le solde passe sous le seuil bas : un vendeur
  /// criblé de litiges ne peut plus creuser son déficit. Voir lib/domain/trust.ts.
  refundsDisabled Boolean      @default(false)
  defaultCurrency Currency     @default(XOF)

  /// Cadence et rail de versement. Le rail (`wave`, `om`, `mtn`, `bank`…)
  /// détermine le JOUR de la semaine où ce créateur est payé — voir
  /// lib/payments/payout-schedule.ts.
  /// Le mensuel par défaut : un seul virement, donc le moins de frais
  /// d'opérateur. Voir la maquette du panneau de versements.
  payoutFrequency PayoutFrequency @default(MONTHLY)
  payoutRail      String?

  /// Versements suspendus sans que le compte le soit.
  ///
  /// Une enquête en cours, un litige avec un acheteur : on arrête de payer
  /// sans couper la boutique. Confondre les deux obligerait à suspendre un
  /// créateur — donc à retirer ses produits de la vente — pour retenir un
  /// virement, ce qui est disproportionné (`payouts_paused?` chez Gumroad).
  payoutsPausedAt     DateTime?
  payoutsPausedReason String?

  /// Compteurs dénormalisés du suivi. La maquette les affiche partout —
  /// en-tête de profil, tableau de bord, carte créateur — et un COUNT() par
  /// affichage sur une table qui grossit sans fin ne tiendrait pas (PLAN §8.2).
  followersCount Int @default(0)
  followingCount Int @default(0)

  /// Secret TOTP, chiffre (AES-256-GCM, voir `lib/auth/totp.ts`).
  ///
  /// Chiffre et non en clair : un secret TOTP est un secret PARTAGE — qui
  /// l'a fabrique les codes. Une fuite de la base seule, un export oublie,
  /// une sauvegarde mal rangee suffiraient a contourner la double
  /// authentification de tout le monde.
  ///
  /// Non nul ne veut PAS dire active : l'activation se fait en deux temps
  /// (on pose le secret, puis on exige un code pour prouver que
  /// l'application l'a bien enregistre). C'est `totpActiveLe` qui tranche.
  totpSecret   String?
  /// Quand la double authentification est devenue exigible. `null` = inactive.
  totpActiveLe DateTime?

  /// Quand l'identite a ete caviardee a la demande de la personne.
  ///
  /// ==========================================================================
  /// LA LIGNE RESTE, ET C'EST LA SEULE FACON DE FAIRE
  ///
  /// Cinq tables refusent la suppression d'un compte — Order, Balance,
  /// BalanceTransaction, Payout, RiskStateChange — parce qu'un grand livre
  /// dont les ecritures perdent leur contrepartie n'est plus un grand livre,
  /// et parce que la comptabilite se conserve des annees.
  ///
  /// L'effacement consiste donc a **caviarder** : l'adresse devient
  /// `efface-<id>@baobart.invalid`, le profil et les messages partent, le mot
  /// de passe et les sessions aussi. Ce qui subsiste est une coquille sans
  /// personne dedans, que les ecritures peuvent continuer de designer.
  ///
  /// Non nul veut dire : ce compte ne represente plus quelqu'un.
  anonymizedAt DateTime?

  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // identité
  profile           Profile?
  billing           BillingInfo?
  payoutAccounts    PayoutAccount[]
  accounts          Account[]
  sessions          Session[]
  passkeys          Passkey[]
  totpRecoveryCodes TotpRecoveryCode[]
  totpChallenges    TotpChallenge[]
  deletionRequest   DeletionRequest?
  passwordResets    PasswordReset[]

  // équipes multi-rôles (§3.10-B)
  memberships TeamMembership[] @relation("TeamMember")
  teamSeats   TeamMembership[] @relation("TeamSeller")

  // social visuel
  workItems WorkItem[]
  boards    Board[]
  likes     Like[]
  comments  Comment[]
  following Follow[]   @relation("Follower")
  followers Follow[]   @relation("Following")

  // commerce
  products Product[]
  orders   Order[]
  cart     Cart?

  // argent
  balances            Balance[]
  balanceTransactions BalanceTransaction[]
  payouts             Payout[]
  mobileMoneyAccounts MobileMoneyAccount[]

  // monétisation & réputation
  subscriptions Subscription[]
  badges        UserBadge[]

  // médias & notifications
  mediaAssets   MediaAsset[]
  notifications Notification[]
  blogPosts     BlogPost[]

  /// Le forum. Les relations vers `Community`, `ForumTopic`, `ForumPost` et
  /// `CommunityChatMessage` sont NOMMÉES : sans nom, Prisma ne saurait pas
  /// distinguer « les communautés que j'ai créées » de celles où je suis
  /// simplement membre.
  ///
  /// `communityMemberships` existait déjà, plus haut dans ce modèle ; elle a
  /// été déplacée ici pour que le bloc se lise d'un tenant.
  communautesCreees       Community[]              @relation("CommunautesCreees")
  communityMemberships    CommunityMembership[]
  sujetsOuverts           ForumTopic[]             @relation("SujetsOuverts")
  messagesDeForum         ForumPost[]              @relation("MessagesDeForum")
  messagesDeChat          CommunityChatMessage[]   @relation("MessagesDeChat")
  notificationPreferences NotificationPreference[]
  abonnementsPush         PushSubscription[]

  // jobs
  offresDeposees       JobPosting[]     @relation("OffresDeposees")
  candidaturesDeposees JobApplication[] @relation("CandidaturesDeposees")

  // services — les prestations proposées par ce créateur
  servicesProposes ServiceOffer[] @relation("ServicesProposes")

  // événements — ceux qu'on organise, et ceux auxquels on s'inscrit
  evenementsOrganises    Event[]             @relation("EvenementsOrganises")
  inscriptionsEvenements EventRegistration[] @relation("InscriptionsEvenements")

  // confiance
  riskStateChanges RiskStateChange[]

  @@index([riskState])
  @@index([platformRole])
  @@index([createdAt, id])
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  username      String  @unique
  displayName   String
  bio           String? @db.Text
  city          String?
  country       String? // ISO 3166-1 alpha-2
  avatarUrl     String?
  bannerUrl     String?
  isVerified    Boolean @default(false) // badge « Créateur vérifié »
  // compteurs dénormalisés (§3.9-H : jamais d'AVG() ni de COUNT() live)
  ratingAvg     Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)
  workCount     Int     @default(0)
  followerCount Int     @default(0)

  /// Vitrine du créateur — écran « Profil public » du tableau de bord.
  /// Tous facultatifs : un acheteur n'a aucune raison de les remplir.
  speciality        String?
  portfolioUrl      String?
  instagram         String?
  behance           String?
  /// Texte libre plutôt qu'un booléen : la maquette attend « Oui, sous
  /// 2 semaines », qui dit à la fois la disponibilité et le délai.
  openToCommissions String?
  /// Tarif journalier indicatif, en unité mineure XOF comme tout montant.
  dailyRate         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

/// Informations de facturation.
///
/// Séparées de `Profile` À DESSEIN : le profil est public, ceci ne l'est pas.
/// Les mélanger ferait qu'un `select` distrait sur le profil exposerait
/// l'adresse postale de quelqu'un. L'écran « Profil » du tableau de bord
/// acheteur les présente ensemble, mais c'est une vue, pas un modèle.
/// Où envoyer l'argent d'un créateur.
///
/// Un modèle à part, pas un champ sur `User` : un numéro de mobile money
/// change, et savoir QUAND il a changé est ce qui permet de repérer le schéma
/// classique — changer le numéro juste avant un versement. Gumroad garde de
/// même l'historique de ses comptes bancaires.
model PayoutAccount {
  id         String       @id @default(cuid())
  userId     String
  method     PayoutMethod
  /// Rail d'acheminement : `wave`, `om`, `mtn`, `moov`, `bank`. C'est lui qui
  /// décide du jour de la semaine où ce créateur est payé.
  provider   String
  /// Numéro mobile money ou identifiant bancaire.
  accountRef String
  /// Nom du titulaire, tel que l'opérateur le connaît. Un écart avec le nom du
  /// compte est le premier motif de rejet d'un virement.
  holderName String?

  /// Le bénéficiaire tel que l'opérateur l'a enregistré.
  ///
  /// Chez Paystack, envoyer de l'argent suppose d'abord de créer un
  /// « transfer recipient » et d'en garder le code. Le recréer à chaque
  /// versement multiplierait les bénéficiaires en double chez l'opérateur, et
  /// rendrait illisible le jour où l'on doit retrouver un virement contesté.
  providerRecipientRef String?

  /// Quel opérateur a délivré cette référence.
  ///
  /// Elle ne vaut que chez lui : changer d'opérateur doit la rendre caduque,
  /// sans quoi on enverrait un code Paystack à Flutterwave.
  recipientProvider String?

  /// Vérifié par un contrôle d'identité. Enregistré mais **pas encore exigé** :
  /// aucun KYC n'existe, et l'exiger aujourd'hui ne paierait personne. À rendre
  /// obligatoire le jour où le contrôle sera en place.
  verifiedAt DateTime?

  /// Compte retiré. Jamais supprimé : un versement passé le référence, et son
  /// historique doit rester lisible.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model BillingInfo {
  id           String  @id @default(cuid())
  userId       String  @unique
  firstName    String?
  lastName     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  /// ISO 3166-1 alpha-2.
  country      String?
  region       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamMembership {
  id        String    @id @default(cuid())
  memberId  String
  sellerId  String
  role      TeamRole
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  member User @relation("TeamMember", fields: [memberId], references: [id], onDelete: Cascade)
  seller User @relation("TeamSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([memberId, sellerId])
  @@index([sellerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // google | github | apple | discord | phone…
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// L'adresse d'ou la session a ete ouverte.
  ///
  /// Elle existe pour une raison precise : le moteur de confiance
  /// (`lib/domain/trust.ts`) emet un effet `BLOQUER_IP` quand un compte est
  /// suspendu pour fraude, et cet effet etait journalise sans etre execute
  /// faute de savoir **quelle** adresse bloquer. C'est ici qu'on l'apprend.
  ///
  /// Nullable : `adresseDe` rend `null` quand rien n'est credible — en
  /// developpement, derriere un tunnel, dans un test.
  ///
  /// Duree de conservation : celle de la session. Rien ne la recopie ailleurs,
  /// et la ligne part avec le compte (`onDelete: Cascade`). C'est une donnee
  /// personnelle au sens de la loi ivoirienne n° 2013-450, et le module
  /// d'effacement la traite comme telle.
  ipAddress String?

  /// Quand cette session a franchi la double authentification.
  ///
  /// Les actions sensibles — versements, changement d'adresse — la relisent
  /// et exigent un passage recent (voir `exigerDeuxFacteursRecent`). Sans
  /// cette colonne, il faudrait soit redemander un code a chaque geste, soit
  /// n'en demander qu'a l'ouverture — et un ordinateur laisse ouvert dans un
  /// cybercafe viderait un compte des heures plus tard.
  ///
  /// `null` sur une session ouverte par quelqu'un qui n'a pas de 2FA : dans
  /// ce cas la garde ne s'applique pas, elle n'a rien a exiger.
  totpValideLe DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Demande de réinitialisation de mot de passe.
///
/// La table ne garde que l'**empreinte** du jeton, comme pour les sessions :
/// une fuite ne permet donc pas de prendre la main sur un compte. SHA-256
/// suffit là où les mots de passe exigent scrypt — un jeton de 32 octets tirés
/// au hasard n'est pas devinable, il n'y a rien à ralentir.
/// Sort d'un appel entrant d'opérateur.
enum WebhookEventStatus {
  /// Reçu et authentifié, pas encore traité.
  RECEIVED
  /// Traité : la commande a bougé.
  PROCESSED
  /// Authentique, mais sans effet — l'état visé était déjà atteint. C'est le
  /// cas normal d'un rejeu, pas une anomalie.
  IGNORED
  /// Signature invalide, corps illisible, ou commande introuvable.
  REJECTED
}

/// Un appel entrant d'un opérateur de paiement.
///
/// ──────────────────────────────────────────────────────────────────────────
/// POURQUOI CETTE TABLE EXISTE
///
/// Un opérateur rejoue ses appels. Sur incident réseau, sur dépassement de
/// délai, et parfois sans raison apparente. Sans trace, un rejeu crédite deux
/// fois le vendeur pour une seule vente — et l'écart ne se voit qu'au moment
/// de verser, des semaines plus tard.
///
/// La clé d'unicité porte donc sur `(provider, eventRef)` : deux appels
/// portant la même référence sont le même fait, et le second ne fait rien.
///
/// ON GARDE AUSSI LES APPELS REFUSÉS. C'est un arbitrage : la route est
/// publique, donc chaque refus enregistré est une écriture qu'un inconnu
/// provoque. On l'accepte parce que la panne la plus fréquente d'une
/// intégration est un secret mal recopié — et que sans ces lignes, elle est
/// parfaitement silencieuse. Le `eventRef` d'un appel refusé est l'empreinte
/// de son corps : un même corps rejoué mille fois n'écrit qu'une ligne.
model PaymentWebhookEvent {
  id String @id @default(cuid())

  /// L'opérateur qui a appelé.
  provider String
  /// Ce que l'opérateur appelle cet événement. Pour un refus : l'empreinte du
  /// corps reçu, faute de pouvoir en croire le contenu.
  eventRef String

  /// La référence de la transaction chez l'opérateur, quand on a pu la lire.
  providerRef String?

  /// Le corps reçu, tel quel. Il ne sert pas à décider — il sert le jour où
  /// l'opérateur conteste ce qu'il affirme avoir envoyé.
  payload Json

  status WebhookEventStatus @default(RECEIVED)
  /// Pourquoi il a été refusé, ou ce qui a échoué au traitement.
  error  String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventRef])
  @@index([status, receivedAt])
  @@index([providerRef])
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String
  token  String @unique

  /// Court : une heure. Un lien de réinitialisation est un mot de passe
  /// temporaire qui traîne dans une boîte mail.
  expiresAt DateTime

  /// Consommé. Le jeton ne sert qu'une fois : sans cela, quiconque relit le
  /// courriel un mois plus tard reprend la main sur le compte.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Un code de secours a usage unique.
///
/// ============================================================================
/// LA SEULE CHOSE ENTRE UN TELEPHONE PERDU ET UN COMPTE FERME
///
/// Sans eux, perdre son telephone ferme le compte definitivement — et il n'y a
/// pas de recours, parce qu'un support technique capable de lever la 2FA de
/// quelqu'un EST une porte derobee.
///
/// Stockes haches, donc irrecuperables : on les montre une fois, et on ne peut
/// plus jamais les reafficher. C'est voulu.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  /// HMAC-SHA256 du code normalise. Pas scrypt : quarante bits tires au
  /// hasard n'ont rien a ralentir — meme raisonnement que `PasswordReset`.
  codeHash  String    @unique
  /// Pose au premier usage. La ligne reste, pour qu'on sache combien de
  /// codes ont deja servi sans avoir a compter des absences.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// L'entre-deux de la connexion : mot de passe donne, code pas encore.
///
/// ============================================================================
/// POURQUOI PAS UNE SESSION MARQUEE « EN ATTENTE »
///
/// Parce que tout le code qui demande « y a-t-il une session ? » repondrait
/// oui. Il faudrait alors que chaque lecture pense a verifier le drapeau, et
/// la premiere qui l'oublie ouvre le compte sans second facteur — sans que
/// rien ne plante.
///
/// Une table a part rend l'oubli impossible : tant que le defi n'est pas
/// releve, il n'existe aucune session du tout.
model TotpChallenge {
  id        String   @id @default(cuid())
  userId    String
  /// Empreinte du jeton pose en cookie, jamais le jeton lui-meme.
  token     String   @unique
  /// Cinq minutes. Au-dela, on recommence par le mot de passe.
  expiresAt DateTime
  /// Combien de codes faux ont ete presentes sur ce defi.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Une demande d'effacement, et le delai avant execution.
///
/// ============================================================================
/// POURQUOI UN DELAI PLUTOT QU'UN EFFACEMENT IMMEDIAT
///
/// L'effacement est irreversible : les messages partent, l'identite est
/// caviardee, et rien ne se rejoue. Un clic suffirait donc a quelqu'un qui a
/// vole une session pour detruire un compte — et la victime n'aurait aucun
/// recours, puisqu'il n'y a plus rien a restaurer.
///
/// Trente jours, annulables a tout moment depuis le compte. C'est aussi le
/// delai que laisse le RGPD pour repondre a une demande (article 12.3), donc
/// on ne fait pas attendre plus que la loi ne le permet.
///
/// ============================================================================
/// LE COMPTE RESTE UTILISABLE PENDANT LE DELAI
///
/// Le fermer tout de suite reviendrait a executer la demande sans attendre :
/// quelqu'un qui change d'avis le decouvrirait enferme dehors, avec un bouton
/// d'annulation derriere une connexion qui ne marche plus.
model DeletionRequest {
  id           String    @id @default(cuid())
  userId       String    @unique
  /// Ce que la personne a ecrit, s'il y a lieu. Jamais exige.
  reason       String?   @db.Text
  /// Quand l'effacement devient executable.
  executeAfter DateTime
  /// Pose a l'execution. La ligne reste : elle prouve que la demande a ete
  /// honoree, et c'est la seule trace qui subsiste du passage.
  executedAt   DateTime?
  /// Pose a l'annulation, par la personne elle-meme.
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([executeAfter, executedAt])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String    @db.Text
  /// Compteur anti-rejeu de l'authentificateur.
  ///
  /// Il s'incremente a chaque usage. S'il RECULE, la cle a ete clonee — c'est
  /// le seul signal de clonage que la specification offre, et le refuser fait
  /// partie du contrat. Beaucoup d'authentificateurs modernes le laissent a
  /// zero en permanence ; on ne refuse donc que la regression stricte.
  counter      Int       @default(0)
  label        String?
  /// Les moyens par lesquels l'authentificateur se joint : usb, nfc, ble,
  /// internal, hybrid. Gardes pour que le navigateur propose le bon geste au
  /// lieu de lister tout ce qu'il connait.
  transports   String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Le defi WebAuthn, entre la demande d'options et la reponse du navigateur.
///
/// ============================================================================
/// IL DOIT VIVRE COTE SERVEUR, ET NULLE PART AILLEURS
///
/// Le defi est ce qui empeche le rejeu : le navigateur signe une valeur que
/// nous avons tiree au hasard, et nous verifions que c'est bien celle-la. Le
/// stocker dans un cookie non signe, ou le renvoyer au client pour qu'il nous
/// le represente, reviendrait a laisser l'attaquant choisir la valeur qu'il
/// signe — et la signature ne prouverait plus rien.
///
/// `userId` est nullable : a la connexion par cle decouvrable, on ne sait pas
/// encore qui se presente. C'est la reponse signee qui le dira.
model WebauthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String   @unique
  /// « enrolement » ou « connexion ». Un defi d'enrolement presente a la
  /// connexion serait accepte sans ce champ, et inversement.
  usage     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ============================================================================
// 2. SOCIAL VISUEL — le cœur Pinterest × Dribbble
// ============================================================================

model WorkItem {
  id            String         @id @default(cuid())
  authorId      String
  title         String
  caption       String?        @db.Text
  coverImageId  String?
  status        WorkItemStatus @default(PUBLISHED)
  shieldLevel   ShieldLevel    @default(WATERMARK_ONLY)
  likesCount    Int            @default(0)
  commentsCount Int            @default(0)
  savesCount    Int            @default(0)
  viewsCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   WorkImage[]
  tags     WorkItemTag[]
  likes    Like[]
  comments Comment[]
  saves    Save[]
  product  Product?

  @@index([status, createdAt, id]) // pagination curseur du feed
  @@index([authorId, createdAt])
}

model WorkImage {
  id         String @id @default(cuid())
  workItemId String
  mediaId    String
  variant    String @default("original") // original | preview | thumb
  width      Int?
  height     Int?
  position   Int    @default(0)

  workItem WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([workItemId])
  @@index([mediaId])
}

model Tag {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  usesCount Int           @default(0)
  workItems WorkItemTag[]
  products  ProductTag[]
}

/// Mots-clés d'une ressource vendable.
///
/// Les shots avaient déjà les leurs (`WorkItemTag`) ; l'écran « Publier une
/// ressource » en demande aussi, et il n'y avait rien pour les recevoir.
model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model WorkItemTag {
  workItemId String
  tagId      String

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workItemId, tagId])
  @@index([tagId])
}

/// Un like porte soit sur un shot du portfolio, soit sur une ressource vendable.
/// Même forme polymorphe que `Save`, pour la même raison : une ressource déposée
/// par le formulaire « Publier » n'a pas de `WorkItem`, et lui en fabriquer un
/// fantôme pour pouvoir l'aimer serait un détour coûteux.
/// Une contrainte SQL impose qu'exactement une des deux cibles soit renseignée —
/// ce que Prisma ne sait pas exprimer.
model Like {
  id         String   @id @default(cuid())
  userId     String
  workItemId String?
  productId  String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, workItemId])
  @@unique([userId, productId])
  @@index([workItemId])
  @@index([productId])
  @@index([userId, createdAt])
}

/// Même polymorphisme que `Like` : on commente un shot ou une ressource.
model Comment {
  id         String    @id @default(cuid())
  authorId   String
  workItemId String?
  productId  String?
  parentId   String? // réponses threadées
  body       String    @db.Text
  likesCount Int       @default(0)
  isFlagged  Boolean   @default(false)
  /// Un commentaire retiré laisse sa place dans le fil : effacer la ligne
  /// emporterait les réponses qui s'y accrochent.
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  @@index([workItemId, createdAt])
  @@index([productId, createdAt])
  @@index([authorId])
}

model Board {
  id           String  @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  isPublic     Boolean @default(true)
  coverImageId String?
  savesCount   Int     @default(0)

  /// La communauté avec laquelle cette collection est partagée, s'il y en a
  /// une.
  ///
  /// C'est le lien que dessine la maquette (`Baobart Accueil.dc.html`, section
  /// `#collab`) : « Collection · Campagne Dakar 2026 — 4 membres · 38
  /// ressources », suivie du fil de la communauté. Les « 4 membres » sont ceux
  /// de la communauté, les « 38 ressources » sont les `saves` de ce tableau.
  ///
  /// Nullable, et c'est le point : une collection reste personnelle par
  /// défaut. La partager est un geste, pas un état initial — et c'est **son
  /// propriétaire** qui le pose, jamais la communauté à sa place.
  ///
  /// `onDelete: SetNull` plutôt que `Cascade` : fermer ou supprimer une
  /// communauté ne doit pas emporter le travail de rangement de quelqu'un.
  /// La collection redevient personnelle, ce qu'elle était avant.
  communityId String?

  createdAt DateTime @default(now())

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  saves     Save[]

  @@index([ownerId])
  /// « Les collections partagées avec cette communauté, la plus récente
  /// d'abord » — la requête de la page communauté.
  @@index([communityId, createdAt])
}

model Save {
  id         String   @id @default(cuid())
  boardId    String
  workItemId String?
  productId  String?
  createdAt  DateTime @default(now())

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([boardId, workItemId])
  @@unique([boardId, productId])
  @@index([workItemId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ============================================================================
// 3. COMMERCE (logique portée de Gumroad — spécification MIT)
// ============================================================================

model Product {
  id            String         @id @default(cuid())
  sellerId      String
  workItemId    String?        @unique // le shot devient vendable
  slug          String         @unique
  name          String
  description   String?        @db.Text
  coverImageId  String?
  type          ProductType    @default(DIGITAL)
  /// Famille affichée dans la barre de filtres du feed.
  family        ProductFamily?
  status        ProductStatus  @default(DRAFT)
  /// Posé quand une suspension de compte archive la ressource, effacé quand la
  /// levée la remet en vente. C'est ce qui permet de rendre ce que la sanction
  /// a retiré sans republier ce que le créateur avait archivé lui-même.
  archivedByRiskAt DateTime?
  /// URL CDN de la couverture, dénormalisée : le feed en affiche des dizaines
  /// par page et ne doit pas résoudre un MediaAsset par carte (PLAN §8.2).
  coverUrl      String?
  /// Extrait public écoutable ou visionnable, pour ce qu'une image ne montre
  /// pas : une nappe sonore, un motion design. Déposé par le créateur — on ne
  /// transcode rien.
  previewUrl    String?
  /// « audio » ou « video » : décide du lecteur à poser sur la fiche.
  previewKind   String?
  price         Int // unité mineure — voir lib/i18n/money.ts
  currency      Currency       @default(XOF)
  licenseTypeId String?

  // ── Montant choisi par l'acheteur (§3.4-B, §3.4-D) ──────────────────────

  /// `FIXED` par defaut : rien ne change pour les ressources existantes.
  pricingMode PricingMode @default(FIXED)

  /// Le plancher en `LIBRE`. `price` sert alors de montant suggere.
  ///
  /// ==========================================================================
  /// POURQUOI GARDER `price` EN PLUS
  ///
  /// Tout le reste du site lit `price` : la mosaique, le fil, la recherche, le
  /// tri par prix. Le vider en `LIBRE` ferait afficher « gratuit » sur une
  /// ressource payante — et `acheter` refuse justement le prix zero.
  ///
  /// `price` reste donc le montant propose, et `minPrice` le minimum accepte.
  minPrice Int?

  /// Montants proposes en un clic. `[500, 1000, 2500]`.
  ///
  /// Trois boutons valent mieux qu'un champ vide : personne ne sait quoi
  /// donner, et un champ vide se remplit surtout du montant le plus bas.
  suggestedPrices Json @default("[]")

  /// Le createur accepte-t-il d'ajuster son prix au pays de l'acheteur ?
  ///
  /// Faux par defaut : c'est une decision commerciale, pas un reglage
  /// technique. Le createur choisit d'etre lu plus largement contre un revenu
  /// plus faible sur une partie de ses ventes, et personne ne peut prendre
  /// cette decision a sa place.
  pppEnabled Boolean @default(false)

  /// La reduction maximale qu'il accepte, en points de base.
  ///
  /// ==========================================================================
  /// POURQUOI UN PLAFOND, ET POURQUOI IL EST INDISPENSABLE
  ///
  /// Le pays vient du formulaire : il est **declare, pas verifie**. Il n'y a
  /// pas de geolocalisation par adresse IP ici, et il n'y en aura pas — celle
  /// qu'on lit sert a gener un retour, jamais a etablir une identite
  /// (`lib/securite/adresse.ts`).
  ///
  /// N'importe qui peut donc choisir le pays le moins cher. Le plafond borne
  /// ce que cela rapporte : sans lui, une reduction de 80 % serait offerte a
  /// qui coche la bonne case, et le createur le decouvrirait sur son releve.
  ///
  /// Nul = la reduction complete du coefficient s'applique.
  pppMaxDiscountBp Int?

  /// Le createur invite-t-il un pourboire au moment de payer ?
  ///
  /// Faux par defaut, et c'est deliberement un choix et non une constante :
  /// afficher un champ de pourboire sur toutes les fiches ajouterait une
  /// question a chaque achat, y compris la ou elle n'a pas de sens.
  tipsEnabled Boolean @default(false)

  // découverte
  isStaffPicked          Boolean   @default(false) // sélection éditoriale §3.10-A
  staffPickedAt          DateTime?
  isBoosted              Boolean   @default(false) // boost payant §10.9
  discoverFeePerThousand Int?

  // compteurs dénormalisés
  salesCount     Int     @default(0)
  downloadsCount Int     @default(0)
  likesCount     Int     @default(0)
  commentsCount  Int     @default(0)
  ratingAvg      Decimal @default(0) @db.Decimal(3, 2)
  ratingCount    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  workItem    WorkItem?     @relation(fields: [workItemId], references: [id])
  licenseType LicenseType?  @relation(fields: [licenseTypeId], references: [id])
  files       ProductFile[]
  tags        ProductTag[]
  variants    Variant[]
  orderItems  OrderItem[]
  saves       Save[]
  likes       Like[]
  comments    Comment[]

  /// Les retraits juridiques qui la visent — voir LegalSuspension.
  legalSuspensions LegalSuspension[]

  @@index([status, createdAt, id]) // curseur feed
  @@index([status, family, createdAt, id]) // curseur feed filtré par famille
  @@index([sellerId, status])
  @@index([isStaffPicked, staffPickedAt])
}

/// Deux natures de fichier, pas une. Le fichier source est ce que l'acheteur
/// reçoit : il reste privé, derrière une URL signée. L'aperçu est ce que tout
/// le monde voit : il vit sous le préfixe public du stockage. Les confondre
/// rendrait le payant téléchargeable gratuitement.
enum ProductFileRole {
  SOURCE
  PREVIEW
}

model ProductFile {
  id        String          @id @default(cuid())
  productId String
  mediaId   String
  filename  String
  sizeBytes Int
  role      ProductFileRole @default(SOURCE)
  position  Int             @default(0)
  /// Retiré d'une ressource **déjà vendue** : la ligne et l'objet au stockage
  /// restent. Un retrait par erreur serait sinon irrécupérable, et ce sont des
  /// acheteurs qui auraient payé pour rien. Reprend le `Deletable` de Gumroad —
  /// qui ne sert pas non plus un fichier retiré, mais n'en détruit jamais les
  /// octets. Sur un brouillon jamais vendu, la ligne part pour de bon.
  deletedAt DateTime?
  createdAt DateTime        @default(now())

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([productId, role, deletedAt])
  @@index([mediaId])
}

model Variant {
  id         String @id @default(cuid())
  productId  String
  name       String
  priceDelta Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  items     Json     @default("[]") // [{productId, variantId, qty}]
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  status      OrderStatus @default(IN_PROGRESS)
  total       Int
  currency    Currency    @default(XOF)
  provider    String? // flutterwave | paystack | cinetpay | stripe
  providerRef String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /// La publicité de l'ADS manager qui a amené cet achat, quand l'acheteur a
  /// cliqué une bannière menant à cette ressource. Nul sinon. La pub peut être
  /// supprimée : la commande reste, l'attribution s'efface.
  adId String?
  ad   Ad?     @relation(fields: [adId], references: [id], onDelete: SetNull)

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([adId])
}

// ════════════════════════════════════════════════════════════════════════════
// ADS MANAGER — les bannières intercalées dans la mosaïque
//
// Repris du plugin WordPress « EDD Ads Manager » (Auceps Digital, v2.2.0) :
// une image ou une vidéo, un lien, une période, une fréquence. Réservé au
// pouvoir `promouvoir_du_contenu` (ADMIN, SUPER_ADMIN, MARKETING).
//
// Deux écarts assumés avec le plugin :
//   — les compteurs sont agrégés par jour, sans IP ni compte : le plugin
//     gardait une ligne par vue, avec l'IP hachée sans sel ;
//   — une vente n'est attribuée qu'à la pub qui menait à la ressource
//     achetée. Le plugin attribuait toute vente des 30 jours suivant un clic.
// ════════════════════════════════════════════════════════════════════════════

enum AdMediaKind {
  IMAGE
  VIDEO
}

model Ad {
  id        String      @id @default(cuid())
  /// Le nom de la campagne. Il sert aussi de texte de remplacement à l'image,
  /// pour qui lit la page avec un lecteur d'écran : le formulaire le dit.
  title     String
  mediaKind AdMediaKind @default(IMAGE)
  /// L'image ou le GIF ; pour une vidéo, son affiche.
  imageUrl    String
  /// Lues au dépôt : la grille place la bannière avant de l'avoir chargée.
  imageWidth  Int
  imageHeight Int
  /// Une vidéo MP4 déposée chez nous. Pas d'iframe YouTube : elle chargerait
  /// un traceur tiers dans la mosaïque de chaque visiteur.
  videoUrl  String?
  /// Un chemin du site (« /products/… ») ou une adresse https.
  linkUrl   String
  /// Une bannière tous les N produits.
  frequency Int
  startsAt  DateTime?
  endsAt    DateTime?
  pausedAt  DateTime?
  /// Archivée : hors de la mosaïque et de la liste active, chiffres gardés.
  /// Il n'y a pas de suppression depuis l'écran — elle effaçait les
  /// affichages et les clics, que rien ne recrée.
  archivedAt DateTime?
  /// Qui l'a créée. Sans relation : effacer ce compte ne doit pas effacer la pub.
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stats  AdDailyStat[]
  orders Order[]

  @@index([archivedAt, pausedAt, startsAt, endsAt])
}

/// Vues et clics d'une pub, par jour. Les ventes se comptent à la lecture,
/// depuis `Order.adId` : les écrire ici en ferait une seconde vérité.
model AdDailyStat {
  adId   String
  day    DateTime @db.Date
  views  Int      @default(0)
  clicks Int      @default(0)

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([adId, day])
}

/// Les réglages de l'ADS manager : une seule ligne, `global`.
model AdSettings {
  id        String   @id @default("global")
  enabled   Boolean  @default(true)
  /// L'écart minimal entre deux bannières, en produits.
  minGap    Int      @default(4)

  /// Les limites contre le gonflage des compteurs, réglables depuis l'écran
  /// (demandé le 03/10). Les deux premières bornent le DÉBIT par adresse ;
  /// les deux suivantes, ce qu'une même adresse peut faire COMPTER par pub et
  /// par jour — c'est ce plafond-là qui empêche le gonflage, le débit ne fait
  /// que le ralentir.
  viewsPerMinute         Int @default(120)
  clicksPerMinute        Int @default(30)
  maxViewsPerVisitorDay  Int @default(20)
  maxClicksPerVisitorDay Int @default(1)

  updatedAt DateTime @updatedAt
}

/// Une ligne d'achat = un produit d'un vendeur. C'est ici que vit l'état de
/// l'argent (équivalent de `Purchase` chez Gumroad), et non sur la commande :
/// un panier multi-vendeurs génère une charge par vendeur, dont l'une peut
/// échouer sans annuler les autres.
model OrderItem {
  id        String        @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int           @default(1)
  state     PurchaseState @default(IN_PROGRESS)

  // Décomposition BRUT → NET, figée au moment de la vente. Le net est ce qui
  // alimente le solde du vendeur : net = price × quantity − les quatre parts.
  price Int // prix unitaire encaissé

  /// Le prix affiche avant remise, quand un code promo a joue.
  ///
  /// ==========================================================================
  /// POURQUOI GARDER LES DEUX
  ///
  /// `price` reste « ce qui a ete encaisse » : c'est lui que lit le bareme de
  /// frais, et la remise est supportee par le vendeur — comme chez Gumroad.
  ///
  /// Mais sans `listPrice`, une vente a 5 000 F avec un code -50 % et une
  /// vente a 5 000 F sans code deviennent indistinguables. Le createur ne
  /// saurait plus si sa campagne a marche, et la question se pose toujours
  /// APRES coup, quand il est trop tard pour l'instrumenter.
  ///
  /// Nul quand aucun code n'a joue : on ne recopie pas `price` dans les deux
  /// colonnes, sinon « il y a une remise » et « il n'y en a pas » se lisent
  /// pareil.
  listPrice   Int?
  /// Le code employe. Scalaire, comme `OfferCode.sellerId` — voir l'audit du
  /// 28 aout sur les cles etrangeres scalaires de ce bloc.
  offerCodeId String?

  /// Le pays declare par l'acheteur au moment de payer, et ce qu'il a change.
  ///
  /// Garde meme quand aucune reduction ne s'applique : c'est ce qui permet de
  /// savoir d'ou viennent les ventes, et de repondre plus tard a « la parite
  /// change-t-elle quelque chose ? » sans avoir a instrumenter apres coup.
  buyerCountry  String?
  /// Les points de base reellement appliques. 0 = prix inchange.
  pppDiscountBp Int     @default(0)

  /// Le pourboire ajoute par l'acheteur, en plus du prix.
  ///
  /// ==========================================================================
  /// A COTE DE `price`, PAS DEDANS
  ///
  /// Chaque colonne dit une chose et une seule : `price` est ce qu'a coute la
  /// ressource, `tipAmount` ce qu'on a donne en plus. Les additionner dans
  /// `price` rendrait impossible de repondre a « combien mes acheteurs
  /// donnent-ils ? », qui est toute la raison d'offrir le pourboire.
  ///
  /// Les frais sont calcules sur la somme des deux — le pourboire emprunte le
  /// meme rail de paiement, qui coute le meme pourcentage. Et le remboursement
  /// rend la somme des deux : rendre tout sauf le pourboire a quelqu'un qui
  /// demande son argent serait indefendable.
  tipAmount Int @default(0)

  /// Ce que l'acheteur a repondu aux champs personnalises du vendeur.
  ///
  /// ==========================================================================
  /// FIGE SUR LA LIGNE, PAS RELU SUR LE PRODUIT
  ///
  /// Meme raison que `price` : le vendeur peut renommer un champ, en changer
  /// les choix ou le supprimer apres la vente. Relire la definition pour
  /// afficher une reponse passee montrerait « Taille : M » sous un champ
  /// devenu « Couleur ».
  ///
  /// La forme est `[{ nom, valeur }]` — le libelle tel qu'il etait, et la
  /// reponse. Pas d'identifiant de champ : un champ supprime laisserait une
  /// reponse orpheline qu'on ne saurait plus nommer.
  customFields Json?
  platformFee  Int   @default(0) // commission Baobart (§2.4 — 10 % ou 20 %, non tranché)
  processorFee Int   @default(0) // mobile money / carte
  affiliateFee Int   @default(0) // part de l'affilié (§10.1)
  taxAmount    Int   @default(0)

  /// Cumul remboursé, dénormalisé depuis Refund. Permet le remboursement
  /// PARTIEL, qu'un simple statut « remboursé » ne sait pas exprimer.
  refundedAmount Int @default(0)

  /// Paiement contesté auprès de la banque ou de l'opérateur : l'argent est
  /// repris sans qu'on ait rien remboursé. Distinct du remboursement, qui est
  /// un geste du vendeur (url_redirects_controller.rb §295 chez Gumroad).
  chargebackAt         DateTime?
  /// Contestation tranchée en faveur du vendeur : l'accès revient.
  chargebackReversedAt DateTime?

  /// Accès coupé à la main par le vendeur — revente en masse, abus. Séparé du
  /// remboursement : on peut retirer l'accès sans rendre l'argent, et rendre
  /// l'argent sans retirer l'accès.
  accessRevokedAt DateTime?

  createdAt DateTime @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  variant    Variant?    @relation(fields: [variantId], references: [id])
  licenseKey LicenseKey?
  refunds    Refund[]

  @@index([orderId])
  @@index([productId])
  @@index([state, createdAt])
  /// Les litiges ouverts se balayent par cette colonne (livraison, supervision).
  @@index([chargebackAt])
}

/// Un remboursement est un ENREGISTREMENT, pas un statut (vérifié : `refunded`
/// n'est pas un état de `purchase_state` chez Gumroad ; les remboursements sont
/// des lignes `Refund` avec leur propre montant). Plusieurs remboursements
/// partiels peuvent s'empiler sur la même ligne d'achat.
model Refund {
  id           String   @id @default(cuid())
  orderItemId  String
  amount       Int
  currency     Currency @default(XOF)
  reason       String?
  processorRef String?
  refundedById String? // null = automatique (politique, litige)

  /// Commission que la plateforme a gardée sur ce remboursement.
  ///
  /// Politique arrêtée : la commission n'est pas rendue, et les frais
  /// d'opérateur restent à la charge du vendeur — c'est donc lui qui finance
  /// le remboursement en entier. Ce champ n'entre dans aucun calcul : il note
  /// ce que Baobart a conservé, faute d'un compte plateforme au grand livre.
  retainedFee Int      @default(0)
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([createdAt])
}

// ============================================================================
// 4. ARGENT — soldes, transactions, payouts
// ============================================================================

/// Solde JOURNALIER d'un vendeur, pas un solde unique.
///
/// Porté de `balance.rb` : une ligne par (vendeur, jour, devise de détention).
/// C'est ce découpage par jour qui rend le versement par lot possible — sans
/// lui, impossible de répondre « voici exactement ce qui part mercredi ».
///
/// INVARIANTE : `amount` et `holdingAmount` ne sont modifiables qu'en état
/// UNPAID. Une fois le solde passé en PROCESSING, il est figé — c'est ce qui
/// empêche une vente tardive de modifier un versement déjà en cours.
/// À faire respecter dans `lib/domain/balances.ts` ET par un trigger Postgres.
model Balance {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  /// Devise d'encaissement et montant net collecté ce jour-là.
  currency Currency @default(XOF)
  amount   Int      @default(0)

  /// Devise de DÉTENTION : ce que Baobart doit réellement au créateur.
  /// Pour les fonds détenus par Baobart c'est toujours le XOF — la dette est
  /// libellée dans la devise de versement, jamais dans celle de l'acheteur.
  holdingCurrency Currency @default(XOF)
  holdingAmount   Int      @default(0)

  state     BalanceState @default(UNPAID)
  payoutId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  payout       Payout?              @relation(fields: [payoutId], references: [id])
  transactions BalanceTransaction[]

  @@unique([userId, date, holdingCurrency])
  @@index([state, date]) // sélection des soldes à verser
  @@index([userId, state])
}

/// Grand livre IMMUABLE : une ligne par mouvement d'argent.
/// Montant positif = crédit au solde, négatif = débit. Jamais de UPDATE ni de
/// DELETE — une erreur se corrige par une écriture inverse.
///
/// Les SIX colonnes monétaires viennent de `balance_transactions` (vérifié dans
/// db/schema.rb) et ne sont pas un luxe : un acheteur de la diaspora paie en
/// EUR pendant que le créateur d'Abidjan est crédité en XOF. Avec un montant
/// unique, on perd soit le montant réellement encaissé, soit la dette réelle.
///   - issued*  : ce qui a été encaissé, dans la devise de l'acheteur
///   - holding* : ce que Baobart doit au vendeur, dans sa devise de versement
///   - gross    : avant frais, taxes et part d'affiliation
///   - net      : après — c'est le net qui alimente le solde
model BalanceTransaction {
  id         String                 @id @default(cuid())
  userId     String
  balanceId  String
  type       BalanceTransactionType
  occurredAt DateTime               @default(now())

  issuedCurrency Currency
  issuedGross    Int
  issuedNet      Int

  holdingCurrency Currency
  holdingGross    Int
  holdingNet      Int

  /// Origine du mouvement — exactement une de ces références est renseignée.
  orderItemId String?
  refundId    String?
  payoutId    String?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance Balance @relation(fields: [balanceId], references: [id])
  payout  Payout? @relation(fields: [payoutId], references: [id])

  @@index([userId, occurredAt])
  @@index([balanceId])
  @@index([orderItemId])
}

model Payout {
  id            String       @id @default(cuid())
  userId        String
  method        PayoutMethod
  provider      String // om | mtn | wave | moov | bank | stripe
  accountRef    String
  amount        Int
  currency      Currency     @default(XOF)
  status        PayoutStatus @default(CREATING)
  scheduledDate DateTime? // le jour où le créateur reçoit l'argent
  /// Le cycle auquel ce versement appartient — c'est LUI qui décide quelles
  /// ventes sont incluses, pas `scheduledDate`. Deux créateurs de rails
  /// différents payés des jours différents partagent le même cycle et donc
  /// la même période de ventes. Confondre les deux fait sauter des créateurs
  /// d'un lot entier. Voir lib/payments/payout-schedule.ts.
  cycleDate     DateTime?    @db.Date
  /// Dernière date de vente incluse (cycle − délai de rétention).
  periodEnd     DateTime?    @db.Date
  processedAt   DateTime?
  isInstant     Boolean      @default(false)
  /// Référence rendue par l'opérateur. C'est elle qui permet de retrouver
  /// l'ordre chez lui le jour où le créateur dit n'avoir rien reçu — sans
  /// elle, une réclamation n'a aucune prise.
  providerRef   String?
  failureReason String?
  createdAt     DateTime     @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  balances     Balance[]
  transactions BalanceTransaction[]

  @@index([userId, status])
  @@index([status, scheduledDate])
  /// Réconciliation : retrouver un versement depuis la référence de l'opérateur.
  @@index([providerRef])
}

model MobileMoneyAccount {
  id         String    @id @default(cuid())
  userId     String
  provider   String // om | mtn | moov | wave
  phone      String
  country    String
  verifiedAt DateTime?
  kycStatus  KycStatus @default(NONE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// Coefficient de parite de pouvoir d'achat, par pays.
///
/// ============================================================================
/// CETTE TABLE EST LIVREE VIDE, ET C'EST UNE DECISION
///
/// Un coefficient PPP est une donnee mesuree — la Banque mondiale publie un
/// « PPP conversion factor » par pays et par annee. Inventer ces nombres pour
/// faire marcher la demonstration reviendrait a poser une reduction sur des
/// valeurs qu'aucune source ne soutient, et personne ne saurait plus lesquelles
/// ont ete verifiees.
///
/// Table vide = aucune reduction nulle part. C'est le comportement sur : un
/// prix reste ce que le createur a ecrit tant qu'on n'a pas charge de chiffres
/// avec leur source.
///
/// ============================================================================
/// ELLE N'A PERSONNE A SERVIR AUJOURD'HUI
///
/// `lib/payments/rails.ts` ne connait que quatre pays — Senegal, Cote
/// d'Ivoire, Ghana, Benin — tous en Afrique de l'Ouest, trois en XOF. La
/// parite entre eux est proche, et le mecanisme ne changera pratiquement rien.
///
/// Il devient utile le jour ou la diaspora peut payer : un createur pourra
/// alors afficher un prix qui tient a Paris et rester abordable a Abidjan.
/// C'est pour ce jour-la qu'il est ecrit, et la matrice le dit.
model PppFactor {
  id         String   @id @default(cuid())
  /// Code ISO 3166-1 alpha-2, en majuscules.
  country    String   @unique
  /// Le coefficient en points de base, relatif au pays de reference.
  ///
  /// 10 000 = prix inchange. 6 000 = l'acheteur paie 60 %. Au-dessus de
  /// 10 000, le prix monterait : `lib/commerce/ppp.ts` le refuse, parce
  /// qu'une « parite » qui renchérit n'est pas ce que le mot annonce.
  factorBp   Int
  /// D'ou vient ce nombre. Obligatoire : un coefficient sans source ne peut
  /// pas etre reverifie, et personne n'osera le corriger.
  source     String
  /// Quand il a ete releve — pas quand la ligne a ete ecrite.
  measuredAt DateTime
  updatedAt  DateTime @updatedAt

  @@index([country])
}

model ExchangeRate {
  id   String   @id @default(cuid())
  from Currency
  to   Currency
  rate Decimal  @db.Decimal(18, 8)
  date DateTime @default(now()) @db.Date

  @@unique([from, to, date])
}

// ============================================================================
// 5. MONÉTISATION & LICENCES
// ============================================================================

model Plan {
  id                String       @id @default(cuid())
  code              PlanCode     @unique
  name              String
  priceMonthly      Int // unité mineure XOF
  downloadsPerMonth Int? // null = illimité (Studio)
  licenseIncluded   LicenseCode?
  shieldLevel       ShieldLevel  @default(NONE)
  features          Json         @default("{}")

  subscriptions Subscription[]
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  cycleStart      DateTime           @default(now())
  /// L'ÉCHÉANCE : la date à laquelle le paiement suivant est dû.
  ///
  /// Ce n'est PAS la date de fin d'accès. Ndank tient deux horloges — voir
  /// `lib/ndank/cycle.ts` — et l'accès dure au-delà, le temps de la grâce.
  /// Confondre les deux couperait un abonné parti en week-end.
  cycleEnd        DateTime
  cadence         Cadence            @default(MENSUEL)
  paymentProvider String?
  providerRef     String?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan                   @relation(fields: [planId], references: [id])
  quotas    DownloadQuota[]
  relances  SubscriptionReminder[]
  paiements SubscriptionPayment[]

  @@index([userId, status])
  @@index([status, cycleEnd])
}

/// Une tentative de paiement d'abonnement.
///
/// ──────────────────────────────────────────────────────────────────────────
/// POURQUOI PAS UNE COMMANDE
///
/// Une commande décrit une vente ENTRE DEUX PERSONNES : elle porte des lignes,
/// chaque ligne porte un produit, et son encaissement crédite le solde d'un
/// vendeur. Un abonnement n'a ni produit ni vendeur — l'argent est celui de la
/// plateforme.
///
/// Faire passer un renouvellement par `Order` obligerait à inventer un produit
/// et un vendeur, et `finaliserVente` créditerait ce vendeur : on fabriquerait
/// une dette de versement envers quelqu'un à qui l'on ne doit rien. Le défaut
/// serait invisible jusqu'au jour du virement.
///
/// ──────────────────────────────────────────────────────────────────────────
/// LA TRACE RESTE, MÊME QUAND L'ABONNÉ ABANDONNE
///
/// Une tentative ratée n'est pas effacée. C'est elle qui dit qu'un rail échoue
/// trop souvent, et c'est elle qu'on montre à l'opérateur quand on le lui
/// reproche.
model SubscriptionPayment {
  id             String                    @id @default(cuid())
  subscriptionId String
  status         SubscriptionPaymentStatus @default(PENDING)
  /// En unités mineures ISO 4217. Figé à l'ouverture : relire le prix du plan
  /// au moment du rappel ferait varier un paiement déjà autorisé.
  amount         Int
  currency       String                    @default("XOF")
  /// L'opérateur qui a ouvert le paiement, ou « simulation ».
  provider       String
  /// La référence de la transaction chez lui, quand il la donne.
  providerRef    String?
  /// L'échéance que ce paiement couvre. Sert à relire ce qui s'est passé sans
  /// avoir à recalculer les cycles.
  cycleEnd       DateTime?
  paidAt         DateTime?
  failedAt       DateTime?
  /// Pourquoi le paiement n'est pas passé. Texte libre : il vient de
  /// l'opérateur, et on ne cherche pas à le normaliser.
  failureReason  String?
  createdAt      DateTime                  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

/// Une relance déjà partie.
///
/// ──────────────────────────────────────────────────────────────────────────
/// C'EST CETTE TABLE QUI EMPÊCHE SEPT SMS POUR UNE ÉCHÉANCE
///
/// Le passage tourne tous les jours et repasse sur les mêmes abonnements. Sans
/// trace de ce qui est déjà parti, la même relance repartirait chaque matin —
/// et le premier SMS de trop suffit à faire désinstaller l'application.
///
/// La clé ne dépend pas de la date du jour mais du **cycle** et du **palier** :
/// un passage rejoué trois fois dans la même journée ne renvoie rien.
model SubscriptionReminder {
  id             String   @id @default(cuid())
  subscriptionId String
  /// « <échéance>:<palier> ». Voir `cleDeCycle` dans Ndank.
  cle            String
  /// Par où c'est parti. Utile le jour où l'on compare le coût des canaux.
  canaux         String[]
  envoyeeLe      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, cle])
  @@index([subscriptionId])
}

/// Un navigateur qui a accepté de recevoir des notifications.
///
/// ───────────────────────────────────────────────────────────────────────
/// UNE PERSONNE, PLUSIEURS APPAREILS
///
/// Une adresse de courriel est unique, un numéro aussi. Un abonnement push,
/// non : quelqu'un installe Baobart sur son téléphone ET sur son ordinateur, et
/// chaque navigateur a le sien. Une relance doit atteindre les deux — sinon
/// elle arrive sur l'appareil resté dans un tiroir.
///
/// ───────────────────────────────────────────────────────────────────────
/// L'ENDPOINT EST L'IDENTITÉ
///
/// C'est le service de poussée du navigateur qui le délivre, et il change quand
/// l'utilisateur révoque puis réaccorde la permission. L'unicité est donc posée
/// dessus : sans elle, un réabonnement du même navigateur créerait une seconde
/// ligne, et la personne recevrait chaque relance en double.
model PushSubscription {
  id       String  @id @default(cuid())
  userId   String
  /// L'URL que le service de poussée du navigateur nous a donnée.
  endpoint String  @unique
  /// Les deux clés du chiffrement de bout en bout (RFC 8291). Sans elles, le
  /// service de poussée ne pourrait pas transmettre un message chiffré — et
  /// avec elles, lui non plus ne peut pas le lire.
  p256dh   String
  auth     String
  /// De quel appareil il s'agit, pour que la personne reconnaisse le sien dans
  /// une liste. Tronqué à l'écriture : une chaîne d'agent entière est du
  /// pistage, pas de l'information.
  appareil String?

  createdAt  DateTime  @default(now())
  /// Dernière poussée acceptée par le service. Sert à repérer les abonnements
  /// qui ne servent plus sans attendre qu'ils soient déclarés morts.
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DownloadQuota {
  id             String @id @default(cuid())
  subscriptionId String
  period         String // « 2026-08 »
  used           Int    @default(0)
  limit          Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
}

/// Chaque consommation d'un fichier laisse une ligne. C'est ce qui alimente le
/// compteur « 2 340 téléchargements » de la maquette, l'analytique créateur, et
/// le décompte des quotas d'abonnement.
model ConsumptionEvent {
  id            String          @id @default(cuid())
  userId        String?
  productId     String
  productFileId String?
  orderItemId   String?
  eventType     ConsumptionType
  platform      Plateforme      @default(AUTRE)
  ipAddress     String?
  consumedAt    DateTime        @default(now())

  @@index([productId, consumedAt])
  @@index([userId, consumedAt])
  @@index([orderItemId])
}

model LicenseType {
  id           String      @id @default(cuid())
  code         LicenseCode @unique
  title        String
  description  String      @db.Text
  conditions   Json        @default("{}") // print, edition, broadcast, merchandising…
  pricePremium Int? // licence étendue payante

  products Product[]
}

model LicenseKey {
  id          String           @id @default(cuid())
  productId   String
  orderItemId String           @unique
  serial      String           @unique // XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX
  status      LicenseKeyStatus @default(ACTIVE)
  usesCount   Int              @default(0)
  disabledAt  DateTime?
  createdAt   DateTime         @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model RevenuePool {
  id            String    @id @default(cuid())
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Int
  creatorsShare Int // 60-70 % redistribué (§2.4)
  distributedAt DateTime?

  allocations RevenuePoolAllocation[]

  @@unique([periodStart, periodEnd])
}

model RevenuePoolAllocation {
  id             String @id @default(cuid())
  poolId         String
  userId         String
  amount         Int
  downloadsCount Int

  pool RevenuePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([userId])
}

// ============================================================================
// 6. GAMIFICATION
// ============================================================================

model Badge {
  id          String    @id @default(cuid())
  code        BadgeCode @unique
  name        String
  description String
  criteria    Json      @default("{}") // formules publiées — transparence §2.6

  awards UserBadge[]
}

model UserBadge {
  id         String    @id @default(cuid())
  userId     String
  badgeId    String
  awardedAt  DateTime  @default(now())
  validUntil DateTime? // cycles glissants

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ============================================================================
// 7. JOBS, ÉVÉNEMENTS, SERVICES  (M3-M4 — FK scalaires pour l'instant)
// ============================================================================

/// L'état d'un contenu soumis à relecture.
///
/// Le même pour les quatre CMS — voir `lib/cms/cycle.ts`, où vivent les
/// transitions permises. Un enum plutôt qu'une chaîne libre : deux orthographes
/// d'un même état rendraient la file de modération inutilisable au moment
/// précis où l'on compte ce qui attend.
enum ContentState {
  BROUILLON
  SOUMIS
  PUBLIE
  REFUSE
  RETIRE
}

/// Où postuler.
enum ApplyMode {
  /// La candidature se dépose sur Baobart. Elle produit un `JobApplication`.
  BAOBART
  /// L'offre renvoie ailleurs. Aucune candidature n'est conservée ici.
  EXTERNE
}

model JobPosting {
  id          String   @id @default(cuid())
  /// Qui a déposé l'offre. Une relation, non un identifiant nu : sans elle,
  /// rien ne garantit qu'il désigne un compte, et l'on ne peut pas remonter aux
  /// offres de quelqu'un qu'on suspend.
  recruiterId String
  title       String
  type        JobType
  mode        JobMode
  country     String?
  city        String?
  salaryMin   Int?
  salaryMax   Int?
  currency    Currency @default(XOF)
  description String   @db.Text

  /// À quelle date l'offre cesse de paraître.
  ///
  /// L'expiration se **déduit** de cette date, elle n'est jamais rangée dans
  /// `state` : un ordonnanceur qui basculerait l'état à minuit serait une
  /// seconde vérité, fausse dès qu'un passage rate son tour. Voir `estPublic`.
  ///
  /// Le formulaire range la **fin du jour** choisi : « jusqu'au 31 octobre »
  /// veut dire que le 31 compte encore.
  deadline DateTime?

  /// ⚠️ BROUILLON par défaut, et surtout pas PUBLIE.
  ///
  /// La valeur précédente était « published » : une offre déposée aurait paru
  /// immédiatement, et la première arnaque aurait été en ligne avant qu'on l'ait
  /// lue. Jobs est ouvert à tout inscrit ; c'est la relecture qui protège, pas
  /// le droit d'entrée.
  state         ContentState @default(BROUILLON)
  /// Pourquoi l'offre a été refusée. Sans motif écrit, un refus est
  /// impossible à expliquer à celui qui le reçoit.
  refusedReason String?      @db.Text
  moderatedAt   DateTime?
  /// L'administrateur qui a tranché. L'audit porte le détail.
  moderatorId   String?

  /// Où postuler. Les deux modes s'excluent : une offre qui accepterait les
  /// deux laisserait le candidat ne pas savoir où aller, et nous ne tiendrions
  /// que la moitié des candidatures.
  applyMode ApplyMode @default(BAOBART)
  /// L'adresse externe, quand `applyMode` vaut EXTERNE.
  ///
  /// ⚠️ C'est le vecteur d'arnaque le plus direct de tout le projet : une URL
  /// d'héconçage déposée sous couvert d'offre d'emploi. Trois règles :
  /// elle est **montrée en entier** au modérateur, elle n'est **jamais suivie**
  /// par le serveur, et elle part au navigateur en `nofollow noopener`.
  applyUrl  String?

  isFeatured Boolean  @default(false) // offre payante §2.9
  isVerified Boolean  @default(false) // badge « Offre vérifiée » — anti-arnaque
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recruiter    User             @relation("OffresDeposees", fields: [recruiterId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  /// La requête publique : état, puis échéance, puis fraîcheur.
  @@index([state, deadline, createdAt])
  @@index([recruiterId, createdAt])
}

/// Une candidature déposée sur Baobart.
///
/// ─────────────────────────────────────────────────────────────────
/// ELLE N'EXISTE QUE POUR LES OFFRES `BAOBART`
///
/// Une offre externe ne produit aucune ligne ici : le candidat part sur le site
/// de l'annonce, et ce qu'il y fait ne nous regarde pas. En conserver une trace
/// serait garder une donnée personnelle sur un acte qu'on n'a pas accompagné.
///
/// ─────────────────────────────────────────────────────────────────
/// CE QU'ELLE PORTE EST UNE DONNÉE PERSONNELLE
///
/// Une candidature dit où quelqu'un cherche du travail. Elle se supprime à la
/// demande, elle disparaît avec le compte (`Cascade`), et le document joint vit
/// dans le stockage privé — jamais dans le préfixe public.
model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  /// Le candidat. Toujours un compte : postuler est une action, et une action
  /// demande d'être inscrit.
  userId    String
  /// Le mot d'accompagnement. Borné à l'écriture.
  message   String?  @db.Text
  /// Le document joint, dans le stockage privé.
  mediaId   String?
  createdAt DateTime @default(now())

  job  JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User       @relation("CandidaturesDeposees", fields: [userId], references: [id], onDelete: Cascade)

  /// Une candidature par personne et par offre. Postuler deux fois n'ajoute
  /// rien pour le recruteur et double le travail de tri.
  @@unique([jobId, userId])
  @@index([userId, createdAt])
}

/// Les catégories dans lesquelles un service se range.
///
/// ─────────────────────────────────────────────────────────────────
/// UNE TABLE, PAS UN ENUM
///
/// L'énumération vieillirait mal : ouvrir une catégorie neuve — « Vidéo »,
/// « Rédaction » — demanderait une migration. Une table est le seul chemin qui
/// permette à l'administration d'en ajouter, d'en cacher, d'en réordonner sans
/// livraison.
///
/// La liste initiale suit la maquette : Identité visuelle, Illustration,
/// Retouche, Motion, Mise en page. Un seed la pose ; l'administration la fait
/// vivre.
model ServiceCategory {
  id       String  @id @default(cuid())
  name     String
  /// URL propre : « identite-visuelle » plutôt que l'identifiant.
  slug     String  @unique
  /// Rang d'affichage. Plus petit = plus haut. Choisi à la main pour que la
  /// maquette impose l'ordre — un tri par nom afficherait l'illustration
  /// avant l'identité visuelle, qui perd son rôle de porte d'entrée.
  position Int
  /// Une catégorie peut être cachée sans être supprimée : effacer une catégorie
  /// qui a déjà servi orphelinerait ses offres.
  isActive Boolean @default(true)

  offers ServiceOffer[]

  @@index([isActive, position])
}

/// Une prestation proposée par un créateur — « je fais X en Y jours pour Z F ».
///
/// ════════════════════════════════════════════════════════════════════════════
/// LE DROIT DE PUBLIER NE VIT PAS ICI
///
/// Trois conditions cumulatives — vendeur, badge Freelance ou Agence,
/// abonnement ouvert. Elles se recalculent à chaque tentative depuis ce qui
/// fait autorité (voir `lib/cms/droits.ts`). Une colonne `peutPublier` ici
/// serait fausse au premier renouvellement manqué.
///
/// ════════════════════════════════════════════════════════════════════════════
/// UN ABONNEMENT SUSPENDU NE CASSE PAS CE QUI EST VENDU
///
/// Ce qui est publié le reste. Le droit se referme sur les *nouvelles* offres,
/// pas sur celles qui existent — couper une prestation déjà commandée
/// pénaliserait le client, qui n'y est pour rien. Voir §18.3 de la spec.
///
/// C'est pourquoi il n'y a aucun ordonnanceur qui « archive » les services
/// d'un abonné dont l'échéance est passée : le seul filtre à la lecture
/// publique est l'état `PUBLIE`, jamais l'abonnement.
model ServiceOffer {
  id         String @id @default(cuid())
  /// Le créateur qui propose la prestation. `Cascade` : sans son compte, la
  /// prestation n'existe plus.
  creatorId  String
  /// La catégorie. Non nulle — une prestation sans catégorie ne se range dans
  /// aucun filtre, donc ne se trouve pas. `Restrict` sur la catégorie : la
  /// supprimer sans avoir migré ses offres ferait tomber les fiches.
  categoryId String

  title       String
  description String @db.Text

  /// « À partir de X F ». Un montant unique et clair — pas de fourchette.
  /// Unité mineure XOF comme tout montant du projet.
  startingPrice Int
  currency      Currency @default(XOF)
  /// Délai annoncé, en jours pleins. Ni « rapide », ni « selon disponibilité » :
  /// un chiffre, pour que le client compare.
  deliveryDays  Int

  /// Le portefeuille de travaux qui appuient l'offre. IDs de `MediaAsset`,
  /// jamais des URLs directes — l'accès reste réglé par le stockage.
  /// Un tableau plutôt qu'une relation : on veut l'ordre choisi par le
  /// créateur, et Prisma le rend mal avec les tables de jointure.
  portfolioMediaIds Json @default("[]")

  /// ⚠️ BROUILLON par défaut. Même raison que Jobs : une prestation
  /// paraîtrait avant d'avoir été relue.
  state         ContentState @default(BROUILLON)
  /// Pourquoi elle a été refusée. Sans motif écrit, un refus n'a pas de
  /// prise sur l'auteur.
  refusedReason String?      @db.Text
  moderatedAt   DateTime?
  moderatorId   String?

  /// Place payante (§2.9 de la spec).
  isFeatured Boolean @default(false)

  /// Compteurs dénormalisés, comme sur `Profile` : jamais d'AVG live sur
  /// une fiche vue mille fois par jour. Ils bougent quand un avis est
  /// posté (le code des avis en est responsable, pas la fiche).
  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User            @relation("ServicesProposes", fields: [creatorId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// La requête publique : état, puis catégorie, puis fraîcheur.
  @@index([state, categoryId, createdAt])
  @@index([creatorId, createdAt])
}

/// Un événement — concours, atelier, conférence, exposition.
///
/// ════════════════════════════════════════════════════════════════════════════
/// DEUX HORLOGES, ET C'EST CE QUE `status` CONFONDAIT
///
/// La version précédente portait `status String @default("upcoming")`, une
/// chaîne libre qui répondait à deux questions sans rapport :
///
///   — **l'état éditorial** — ce contenu existe-t-il pour le public ? Il
///     résulte d'une décision humaine, donc il se range. C'est `state`,
///     le même `ContentState` que les trois autres CMS ;
///   — **la phase** — où en est-on du calendrier ? Elle résulte du temps qui
///     passe, donc elle se **calcule**. Voir `lib/evenements/phases.ts`.
///
/// Les tenir dans une colonne rendait l'une des deux fausse dès qu'on touchait
/// à l'autre — et le défaut `"upcoming"` publiait tout événement créé, avant
/// même qu'on ait fini de le rédiger.
///
/// ════════════════════════════════════════════════════════════════════════════
/// ANNULER N'EST PAS RETIRER
///
/// `cancelledAt` existe à part de `state`, et la distinction n'est pas
/// cosmétique : un événement annulé doit **rester visible**. Les inscrits ont
/// noté la date, prévu un déplacement, peut-être payé un billet — les envoyer
/// sur une page absente les laisserait chercher.
///
/// `RETIRE` est pour ce qui n'aurait pas dû paraître. `cancelledAt` est pour
/// ce qui n'aura pas lieu, et qui doit le dire.
model Event {
  id          String    @id @default(cuid())
  /// Qui organise. Une relation, non un identifiant nu : sans elle, rien ne
  /// garantit qu'il désigne un compte, et l'on ne peut pas remonter aux
  /// événements de quelqu'un qu'on suspend.
  organizerId String
  title       String
  kind        EventKind
  /// La présentation, en texte. Elle manquait — un événement sans description
  /// n'est qu'une date et un titre.
  description String    @db.Text
  coverUrl    String?

  startsAt DateTime
  endsAt   DateTime
  location String?
  isOnline Boolean  @default(false)

  ticketPrice Int?
  currency    Currency @default(XOF)
  /// `null` veut dire « sans plafond », et surtout pas zéro.
  capacity    Int?

  /// ⚠️ BROUILLON par défaut. La valeur précédente était `"upcoming"` : un
  /// événement paraissait dès sa création, avant d'être fini de rédiger.
  state         ContentState @default(BROUILLON)
  /// Posée quand l'événement est annulé. Il reste visible — voir l'en-tête.
  cancelledAt   DateTime?
  /// Pourquoi. Un « annulé » sans raison fait écrire tous les inscrits.
  cancelReason  String?      @db.Text
  /// Pourquoi la fiche a été refusée à la relecture.
  ///
  /// Deux colonnes de raison sur la même table, et elles ne se remplacent pas :
  /// `cancelReason` s'adresse aux INSCRITS d'un événement qui n'aura pas lieu,
  /// `refusedReason` s'adresse à l'ORGANISATEUR d'une fiche qui ne paraîtra
  /// pas. Les fondre ferait lire à des inscrits le motif d'un refus éditorial.
  ///
  /// Même nom que sur `JobPosting` et `ServiceOffer` : trois CMS, une seule
  /// convention, et rien à retenir de plus en passant de l'un à l'autre.
  refusedReason String?      @db.Text
  /// Qui a relu, et quand. L'audit porte le détail ; ces deux colonnes servent
  /// à l'écran, qui ne doit pas avoir à le parcourir pour afficher une date.
  moderatedAt   DateTime?
  moderatorId   String?

  /// Concours : la dotation et le jury.
  prizeAmount Int?
  jury        Json?

  /// Compteur dénormalisé, comme partout ailleurs (§3.9-H du plan).
  participantsCount Int     @default(0)
  /// Place payante (§2.9) : accueil et feed.
  isFeatured        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer     User                @relation("EvenementsOrganises", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  /// La requête publique : état, puis chronologie.
  @@index([state, startsAt])
  @@index([organizerId, startsAt])
}

/// Une inscription à un événement.
///
/// ════════════════════════════════════════════════════════════════════════════
/// SE DÉSINSCRIRE EFFACE LA LIGNE
///
/// Il n'y a pas de colonne d'état ici, et c'est délibéré. La version
/// précédente portait `status String @default("registered")`, qui aurait servi
/// à marquer une désinscription — sauf que l'unicité `(eventId, userId)`
/// aurait alors **empêché de se réinscrire**. Quelqu'un qui se désiste puis
/// change d'avis se serait heurté à sa propre ligne annulée, sans que rien ne
/// le dise.
///
/// La présence de la ligne fait donc foi. Se désinscrire l'efface, et le
/// compteur suit.
///
/// La trace de ce qui a été payé est une autre affaire : un billet remboursé
/// appartient au registre des paiements, pas à celui des présences.
model EventRegistration {
  id         String   @id @default(cuid())
  eventId    String
  /// Toujours un compte : s'inscrire est une action, et une action demande
  /// d'être inscrit. `Cascade` — sans le compte, l'inscription n'existe plus.
  userId     String
  /// Ce qui a été réglé, quand le billet est payant.
  ticketPaid Int?
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("InscriptionsEvenements", fields: [userId], references: [id], onDelete: Cascade)

  /// Une inscription par personne et par événement.
  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model Commission {
  id               String   @id @default(cuid())
  sellerId         String
  buyerId          String
  productId        String
  status           String   @default("in_progress") // in_progress | completed | cancelled
  depositAmount    Int // acompte 50 %
  completionAmount Int? // solde à la livraison
  brief            String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([sellerId, status])
  @@index([buyerId])
}

model Call {
  id          String   @id @default(cuid())
  sellerId    String
  buyerId     String
  productId   String
  scheduledAt DateTime
  durationMin Int
  meetingUrl  String?
  status      String   @default("scheduled")

  @@index([sellerId, scheduledAt])
}

// ============================================================================
// 8. COMMUNAUTÉ & FORUM  (M5)
// ============================================================================

/// Un espace communautaire, ouvert par un créateur.
///
/// ════════════════════════════════════════════════════════════════════════════
/// LES AUTEURS SONT DES RELATIONS, PLUS DES IDENTIFIANTS NUS
///
/// Les cinq tables de ce bloc portaient des `authorId String` sans `@relation`
/// — l'audit du 28 août les appelait « clés étrangères scalaires ». Rien ne
/// garantissait qu'un identifiant désigne un compte, et l'on ne pouvait pas
/// afficher le nom de qui écrit sans une seconde requête par ligne.
///
/// `onDelete: Cascade` sur l'auteur : quelqu'un qui ferme son compte emporte
/// ses messages. C'est le choix qu'impose le RGPD, et il vaut mieux que la
/// solution habituelle — remplacer l'auteur par « compte supprimé » —, qui
/// laisse le texte en ligne alors que c'est souvent lui qu'on voulait faire
/// disparaître.
model Community {
  id           String              @id @default(cuid())
  creatorId    String
  name         String
  slug         String              @unique
  description  String?             @db.Text
  coverImageId String?
  visibility   CommunityVisibility @default(PUBLIC)
  memberCount  Int                 @default(0)
  status       String              @default("active")
  createdAt    DateTime            @default(now())

  creator      User                   @relation("CommunautesCreees", fields: [creatorId], references: [id], onDelete: Cascade)
  members      CommunityMembership[]
  categories   ForumCategory[]
  chatMessages CommunityChatMessage[]
  /// Les collections que des membres ont partagées ici. Voir `Board.communityId`.
  collections  Board[]

  /// L'annuaire demande « les actives, visibles, les plus peuplées d'abord ».
  @@index([status, visibility, memberCount])
}

model CommunityMembership {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        ForumRole @default(MEMBER)
  joinedAt    DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

/// Le fil d'une communauté : un flux plat, sans sujet ni rubrique.
///
/// C'est la forme que dessine la maquette (`Baobart Accueil.dc.html`, section
/// `#collab` — « Vos espaces d'équipe ») : `{{ c.who }}`, `{{ c.when }}`,
/// `{{ c.text }}`, et une zone « Écrire un commentaire… ». Pas de titre, pas
/// de fil de discussion, pas de réponse à une réponse.
///
/// `ForumTopic` et `ForumPost` existent à côté et portent la version à trois
/// niveaux. Ils ne sont reliés à aucun écran pour l'instant : la maquette ne
/// les dessine pas, et elle fait foi.
model CommunityChatMessage {
  id          String @id @default(cuid())
  communityId String
  authorId    String
  body        String @db.Text

  /// Signalé par un membre. Le message reste visible et marqué — voir
  /// `ForumPost.isFlagged`, même règle : le masquer ferait disparaître le
  /// contexte d'une conversation dont les réponses citent ce qu'on a signalé.
  isFlagged Boolean @default(false)

  createdAt DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation("MessagesDeChat", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  /// La file de signalements, qui lit tous les espaces à la fois.
  @@index([isFlagged, createdAt])
}

model ForumCategory {
  id          String @id @default(cuid())
  communityId String
  name        String
  slug        String
  position    Int    @default(0)

  community Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  topics    ForumTopic[]

  @@unique([communityId, slug])
}

model ForumTopic {
  id           String   @id @default(cuid())
  categoryId   String
  authorId     String
  title        String
  viewsCount   Int      @default(0)
  repliesCount Int      @default(0)
  isPinned     Boolean  @default(false)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User          @relation("SujetsOuverts", fields: [authorId], references: [id], onDelete: Cascade)
  posts    ForumPost[]

  /// Les sujets se lisent « épinglés d'abord, puis les plus récents ».
  /// L'ordre de l'index suit l'ordre du tri, sinon il ne sert pas.
  @@index([categoryId, isPinned, createdAt])
  @@index([categoryId, createdAt])
}

model ForumPost {
  id         String   @id @default(cuid())
  topicId    String
  authorId   String
  body       String   @db.Text
  likesCount Int      @default(0)
  isFlagged  Boolean  @default(false)
  createdAt  DateTime @default(now())

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User       @relation("MessagesDeForum", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  /// La file de modération demande « les signalés, les plus anciens d'abord ».
  @@index([isFlagged, createdAt])
}

/// Le centre de notifications, dans l'application.
///
/// La table existait depuis le début et n'était **jamais écrite** : un écran
/// l'aurait affichée vide, ce qui se lit « il ne s'est rien passé ». Elle est
/// alimentée depuis v1.52.0 par `lib/notifications/aiguilleur.ts`.
///
/// Notre référent — Gumroad — n'a pas cet écran : il est courriel d'abord, et
/// pousse sur mobile via son application native. Baobart n'a ni l'un ni
/// l'autre, et ses utilisateurs ne vivent pas dans leur boîte mail. Le centre
/// in-app est donc le seul canal qu'on maîtrise de bout en bout.
model Notification {
  id     String @id @default(cuid())
  userId String
  /// Le code de l'événement — voir `EvenementNotifiable` dans
  /// `lib/notifications/catalogue.ts`. Une chaîne plutôt qu'un enum : ajouter
  /// un type de notification ne doit pas demander une migration.
  type   String

  /// Ce qui empêche le doublon, sur la même règle que `EmailOutbox`.
  ///
  /// Dérivée du fait qui justifie l'avis — « vente-<orderItemId> » — et non
  /// d'un hasard : un webhook rejoué par l'opérateur doit retomber sur la même
  /// clé et se faire refuser, plutôt que de poser une seconde ligne dans la
  /// cloche de quelqu'un.
  cle String @unique

  /// Ce qu'on affiche. Deux champs plutôt qu'un rendu à la lecture : le texte
  /// d'une notification doit rester ce qu'il était au moment des faits, même
  /// si la ressource qu'il décrit a changé de nom depuis.
  titre String
  corps String  @db.Text
  /// Où elle mène. `null` quand il n'y a rien à ouvrir.
  lien  String?

  /// Le détail, pour l'avenir. Jamais affiché tel quel : il peut porter un
  /// lien de téléchargement.
  payload Json @default("{}")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `readAt` dans l'index : la question posée à chaque chargement de page est
  /// « combien de non-lues ? », et elle doit se répondre sans parcourir.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Ce que quelqu'un a choisi de ne plus recevoir, ou de recevoir en plus.
///
/// ════════════════════════════════════════════════════════════════════════════
/// UNE LIGNE PAR COUPLE (ÉVÉNEMENT × CANAL)
///
/// C'est l'unité de préférence, reprise de Gumroad : quelqu'un peut vouloir la
/// sonnerie de sa vente sans un courriel de plus. Un interrupteur global ne sait
/// pas exprimer ça, et devient donc un interrupteur « tout couper ».
///
/// Ce qu'on ne reprend PAS de lui : le rangement. Chez Gumroad ce sont des bits
/// dans une colonne entière (`has_flags`), et le flag 54 est atteint —
/// illisible en base, et « qui reçoit encore les reçus ? » devient un parcours
/// de table.
///
/// ════════════════════════════════════════════════════════════════════════════
/// SEULEMENT CE QUI A ÉTÉ CHANGÉ
///
/// Pas de ligne pour chaque couple à l'inscription : l'absence veut dire « le
/// défaut du code s'applique ». C'est ce qui permet de changer un défaut sans
/// migrer une table — personne ne porte une copie figée de ce qu'on avait
/// décidé le jour de son inscription.
model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  /// Code d'événement, comme `Notification.type`.
  evenement String
  /// COURRIEL | IN_APP | PUSH. PUSH se range déjà bien qu'il ne soit pas
  /// livré : l'allumer plus tard ne demandera pas de migration.
  canal     String
  actif     Boolean

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un seul réglage par couple. Sans cette contrainte, deux écritures
  /// concurrentes laisseraient deux lignes contradictoires, et la lecture
  /// dépendrait de l'ordre.
  @@unique([userId, evenement, canal])
  @@index([userId])
}

// ============================================================================
// 9. CROISSANCE  (M2-M7 — FK scalaires pour l'instant)
// ============================================================================

model Affiliate {
  id                 String   @id @default(cuid())
  sellerId           String
  affiliateUserId    String?
  type               String   @default("DIRECT") // DIRECT (peer) | GLOBAL (ambassadeur)
  basisPoints        Int      @default(1000) // 10 %
  cookieLifetimeDays Int      @default(7)
  status             String   @default("active")
  createdAt          DateTime @default(now())

  credits AffiliateCredit[]

  @@index([sellerId])
  @@index([affiliateUserId])
}

model AffiliateRequest {
  id          String   @id @default(cuid())
  sellerId    String
  applicantId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([sellerId, applicantId])
}

model AffiliateCredit {
  id          String   @id @default(cuid())
  affiliateId String
  orderItemId String
  amount      Int
  status      String   @default("on_hold")
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

/// Un code promo, emis par un vendeur sur ses propres ressources.
///
/// ============================================================================
/// LE CODE EST STOCKE NORMALISE
///
/// Majuscules, sans espaces. Un code ecrit « Noel 25 » et tape « noel25 » ne
/// se retrouverait pas : la base compare des octets. Le code s'afficherait
/// dans l'ecran du vendeur, la personne le taperait comme il l'a lu, et rien
/// ne se passerait — sans erreur, sans trace.
///
/// C'est `lib/commerce/codes-promo.ts` qui normalise, a l'ecriture comme a la
/// lecture, et la contrainte d'unicite porte sur la valeur normalisee.
///
/// ============================================================================
/// `usesCount` NE SE LIT PAS AVANT DE S'INCREMENTER
///
/// Deux acheteurs qui presentent le dernier exemplaire au meme instant
/// liraient tous deux « 9 sur 10 » et ecriraient tous deux « 10 ». Le plafond
/// serait depasse d'un, et personne ne le verrait — le compteur afficherait
/// exactement la bonne valeur.
///
/// L'increment se fait donc dans un `updateMany` qui porte le plafond dans son
/// `WHERE` : la base tranche, pas nous.
model OfferCode {
  id                     String    @id @default(cuid())
  sellerId               String
  code                   String
  type                   String // PERCENT | FIXED
  amount                 Int
  durationDays           Int?
  maxUses                Int?
  usesCount              Int       @default(0)
  isCancellationDiscount Boolean   @default(false)
  productIds             Json      @default("[]") // [] = tous les produits
  expiresAt              DateTime?
  /// Pose quand le vendeur retire le code sans vouloir l'effacer.
  ///
  /// Distinct de l'expiration : une date passee dit « la campagne est finie »,
  /// ceci dit « arretez tout de suite ». Les deux doivent exister, parce qu'on
  /// arrete rarement une campagne a l'heure prevue.
  disabledAt             DateTime?
  createdAt              DateTime  @default(now())

  @@unique([sellerId, code])
  @@index([sellerId, createdAt])
}

model Upsell {
  id               String  @id @default(cuid())
  sellerId         String
  triggerProductId String
  offerProductId   String
  variantId        String?
  discountPercent  Int?
  isActive         Boolean @default(true)

  @@index([triggerProductId])
}

/// La relance d'un paiement laisse en plan.
///
/// ============================================================================
/// LE PANIER N'EXISTE PAS SUR CETTE PLATEFORME
///
/// Ce modele s'appelait `SentAbandonedCartEmail` et portait un `cartId`. Il
/// n'a jamais eu ni lecteur ni ecrivain, et pour cause : `Cart` n'est ecrit
/// nulle part. On achete une ressource a la fois, depuis sa fiche — il n'y a
/// pas d'etape « panier » a abandonner.
///
/// Ce qui s'abandonne vraiment ici, c'est un paiement mobile money OUVERT :
/// l'invite part sur un telephone, et l'acheteur ne la confirme jamais. C'est
/// frequent — le commentaire de `PEREMPTION_MS` le dit deja — et c'est la
/// seule abandon qu'on puisse relancer.
///
/// Construire la relance sur `Cart` aurait produit un module qui ne se
/// declenche jamais : correct, teste, et sans effet.
///
/// ============================================================================
/// UNE SEULE RELANCE, ET C'EST LA BASE QUI LE GARANTIT
///
/// `orderId` est unique. Deux passages d'ordonnanceur qui se chevauchent ne
/// peuvent donc pas ecrire deux fois — la seconde insertion echoue sur la
/// contrainte, ce qui est exactement le comportement voulu.
///
/// Relancer deux fois quelqu'un qui a renonce est le genre de detail qui fait
/// classer un expediteur en indesirable, et la delivrabilite ne revient pas.
model RelancePaiement {
  id        String   @id @default(cuid())
  orderId   String   @unique
  sentAt    DateTime @default(now())
  /// Pose quand la commande relancee finit par aboutir.
  ///
  /// Mesure, pas suppose : c'est la seule facon de savoir si la relance sert a
  /// quelque chose. Sans cette colonne, on continuerait d'envoyer sans jamais
  /// pouvoir dire si ca marche.
  converted Boolean  @default(false)

  @@index([sentAt])
}

/// Une question que le vendeur pose au moment de l'achat.
///
/// ============================================================================
/// `FILE` EST DECLARE ET N'EST PAS SERVI
///
/// Les quatre autres types se remplissent dans le formulaire et repartent avec
/// lui. Un fichier, non : il faut une URL signee, un televersement direct vers
/// le stockage, et une reservation a confirmer — c'est-a-dire tout le chemin de
/// `lib/upload/`, AVANT le paiement, sur un reseau mobile.
///
/// Le declarer sans le servir serait un champ que l'acheteur voit et ne peut
/// pas remplir. `lib/commerce/champs.ts` le refuse donc a la creation, avec un
/// message qui le dit.
model CustomField {
  id         String  @id @default(cuid())
  productId  String
  name       String
  fieldType  String // TEXT | CHOICE | BOOLEAN | TERMS | (FILE : declare, non servi)
  isRequired Boolean @default(false)
  position   Int     @default(0)
  /// Les choix, pour `CHOICE`. Vide pour les autres types.
  options    Json    @default("[]")

  @@index([productId, position])
}

model Post {
  id             String    @id @default(cuid())
  sellerId       String
  title          String
  body           String    @db.Text
  audienceFilter Json      @default("{}") // tous | acheteurs | followers | segment
  scheduledAt    DateTime?
  sentAt         DateTime?
  openRate       Decimal?  @db.Decimal(5, 4)
  createdAt      DateTime  @default(now())

  deliveries PostDelivery[]

  @@index([sellerId, createdAt])
}

model PostDelivery {
  id       String    @id @default(cuid())
  postId   String
  email    String
  status   String    @default("pending") // pending | sent | opened | bounced
  sentAt   DateTime?
  openedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
}

/// Un article du blog Baobart.
///
/// ════════════════════════════════════════════════════════════════════════════
/// `ContentState`, ET NON LE `status` DE §4.1
///
/// La spec demandait une chaîne : `draft | review | published | archived`.
/// §18 prime sur les §§4 à 7, et impose le cycle partagé des quatre CMS —
/// c'est lui qui garantit qu'un état ajouté un jour vaille pour tous, et que
/// « retiré » veuille dire la même chose partout.
///
///   draft     → BROUILLON
///   review    → SOUMIS
///   published → PUBLIE
///   archived  → RETIRE
///
/// `REFUSE` s'y ajoute gratuitement, et sert : §4.3 voulait qu'un second
/// administrateur relise, et un relecteur doit pouvoir dire non avec un motif.
///
/// ════════════════════════════════════════════════════════════════════════════
/// LA RELECTURE EST OFFERTE, PAS IMPOSÉE
///
/// §4.3 la voulait obligatoire. §18.1 dit que l'auteur d'un article porte déjà
/// le droit de publier — lui faire traverser une file l'obligerait à
/// s'auto-approuver, c'est-à-dire à faire semblant.
///
/// Les deux se rejoignent : `BROUILLON → SOUMIS` existe et l'écran l'offre,
/// `BROUILLON → PUBLIE` aussi. Qui veut un second regard le demande.
model BlogPost {
  id       String @id @default(cuid())
  authorId String
  title    String
  /// L'adresse publique. Unique, et elle ne change plus après publication —
  /// même règle que les ressources : un lien partagé ne doit pas mourir.
  slug     String @unique

  /// Le résumé des cartes. `null` veut dire « déduis-le du premier
  /// paragraphe » — voir `extraitAutomatique`. Le ranger vide plutôt que
  /// calculé permet de changer la façon de le déduire sans réécrire la table.
  excerpt  String?
  /// Markdown restreint, jamais d'HTML. Voir `lib/blog/corps.ts` : ce projet
  /// ne rend d'HTML nulle part, et un blog n'est pas une raison de commencer.
  body     String  @db.Text
  coverUrl String?

  categoryId    String?
  state         ContentState @default(BROUILLON)
  /// Pourquoi la relecture a refusé. Même nom que sur les trois autres CMS.
  refusedReason String?      @db.Text
  moderatedAt   DateTime?
  moderatorId   String?

  /// « À la une » sur la liste. Un booléen plutôt qu'un rang : on met en avant
  /// ou non, et classer dix articles à la main est un écran que personne
  /// n'ouvre.
  isFeatured Boolean @default(false)

  /// SEO. `null` partout veut dire « prends le titre et l'extrait » : deux
  /// champs vides valent mieux que deux champs recopiés qui divergeront.
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  publishedAt DateTime?
  /// Quand l'article doit paraître tout seul.
  ///
  /// ════════════════════════════════════════════════════════════════════════
  /// UNE DATE QUI NE VAUT QUE SUR UN BROUILLON
  ///
  /// Le passage quotidien ne publie que ce qui est en `BROUILLON` et dont
  /// l'heure est passée. Sur un article déjà en ligne, la colonne ne veut
  /// plus rien dire — elle est effacée à la publication, pour qu'elle ne
  /// laisse pas croire qu'une seconde parution est prévue.
  ///
  /// §4.3 la demandait. Elle n'avait pas été créée en v1.53.0, et c'était
  /// délibéré : une colonne que rien ne lit est une promesse qu'on croit
  /// tenue. Elle arrive avec le passage qui la lit.
  scheduledAt DateTime?
  /// Compteur dénormalisé, comme ailleurs (§3.9-H du plan).
  viewsCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// La liste publique lit « publiés, du plus récent » ; l'administration lit
  /// « tous, du plus récent ». Un seul index sert les deux.
  @@index([state, publishedAt])
  @@index([authorId, createdAt])
  /// Le passage quotidien demande « les brouillons dont l'heure est passée ».
  /// Sans cet index, il parcourt tous les articles chaque matin.
  @@index([state, scheduledAt])
}

/// Les rubriques du blog.
///
/// Sans `position` : l'ordre d'affichage est alphabétique, et une poignée de
/// rubriques ne se réordonne pas — c'est un écran de plus pour un gain nul.
model BlogCategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts BlogPost[]
}

// ============================================================================
// 10. CONFIANCE, MODÉRATION & AUDIT
// ============================================================================

model BlockedObject {
  id          String    @id @default(cuid())
  objectType  String // IP | EMAIL | PHONE | CARD | OBJECT
  objectValue String
  reason      String?
  expiresAt   DateTime? // expiration automatique (6 mois pour les IP)
  createdAt   DateTime  @default(now())

  /// Le compte a l'origine du blocage, quand il y en a un.
  ///
  /// Ce n'est pas de la tracabilite : c'est ce qui rend la levee possible.
  /// Le moteur de confiance emet `BLOQUER_IP` a la suspension et
  /// `DEBLOQUER_IP` a la levee, mais il emet aussi `INVALIDER_SESSIONS`
  /// AVANT le premier — les sessions, donc les adresses, ont disparu quand
  /// vient le moment de lever. Sans cette colonne, la levee ne saurait pas
  /// quelles lignes retirer, et les retirerait toutes ou aucune.
  ///
  /// Pas de relation Prisma : un blocage doit survivre a la suppression du
  /// compte qui l'a motive. C'est meme son interet principal — quelqu'un qui
  /// efface son compte et se reinscrit depuis la meme adresse.
  userId String?

  @@unique([objectType, objectValue])
  @@index([expiresAt])
  @@index([userId])
}

/// Journal des décisions de risque.
///
/// Ce n'est pas de la traçabilité décorative : c'est la table que relit le
/// contrôle de solde négatif pour savoir **qui** avait posé une probation et si
/// **quelqu'un d'autre a tranché depuis**. Sans elle, la levée automatique ne
/// peut pas distinguer sa propre décision de celle d'un administrateur — et
/// finirait par défaire un jugement humain.
model RiskStateChange {
  id        String        @id @default(cuid())
  userId    String
  fromState UserRiskState
  toState   UserRiskState
  /// Qui a décidé : identifiant d'administrateur, ou nom du contrôle
  /// automatique (voir AUTEUR_CONTROLE_SOLDE dans lib/domain/trust.ts).
  author    String
  reason    String?       @db.Text
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, author, createdAt])
}

model ModerationLog {
  id         String   @id @default(cuid())
  entityType String // product | work_item | comment | forum_post
  entityId   String
  reason     String
  action     String // blocked | flagged | approved
  actorId    String? // null = automatique
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model FraudWarning {
  id          String   @id @default(cuid())
  orderItemId String
  processor   String
  riskLevel   String
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
}

// ============================================================================
// 11. MÉDIAS — upload direct presign + pipeline Shield
// ============================================================================

enum EmailStatus {
  PENDING
  SENDING
  SENT
  /// Échec définitif : plus aucune tentative automatique.
  FAILED
  /// Fermé à la main. Une adresse qui n'existe plus resterait rouge à jamais
  /// et masquerait les vraies pannes.
  ABANDONED
}

enum EmailTemplate {
  BIENVENUE
  REINITIALISATION_MOT_DE_PASSE
  RECU_ACHAT
  LIEN_TELECHARGEMENT
  AVIS_VERSEMENT
  RELANCE_ABONNEMENT
  RECU_ABONNEMENT

  /// Ajoutés en v1.52.2. Ces avis existaient déjà et n'étaient livrés qu'en
  /// in-app : le catalogue des notifications les portait avec `modele: null`,
  /// et l'écran de réglages l'annonçait en toutes lettres.
  ///
  /// L'ordre suit `lib/email/modeles.ts`, et les deux listes doivent rester
  /// identiques — un test le vérifie.
  COMMANDE_REMBOURSEE
  EVENEMENT_ANNULE
  VENTE_REALISEE
  CONTENU_PUBLIE
  CONTENU_REFUSE
  CANDIDATURE_RECUE
  INSCRIPTION_EVENEMENT
  NOUVEL_ABONNE

  /// Ajouté en v1.57.0 avec les notifications juridiques.
  ///
  /// Celui-ci ne pouvait pas rester en in-app seulement : il ouvre une fenêtre
  /// de réponse au bout de laquelle le contenu ne revient pas. Une cloche
  /// qu'on n'ouvre pas ferait courir ce délai dans le vide.
  RETRAIT_JURIDIQUE

  /// Ajoute en v1.64.0 avec la relance de paiement.
  ///
  /// Le seul de cette liste qui DEMANDE quelque chose au lieu de rendre compte
  /// d'un fait. Une seule relance par commande, garantie par la contrainte
  /// d'unicite de `RelancePaiement.orderId`.
  PAIEMENT_ABANDONNE

  /// Ajouté en v1.69.12 : l'avis aux inscrits quand une annulation est levée.
  /// Sans lui, quelqu'un qui avait lu « annulé » n'apprenait jamais que
  /// l'événement revenait.
  EVENEMENT_MAINTENU
}

/// File d'attente des messages transactionnels.
///
/// Un message part **après** la transaction qui le justifie. S'il partait
/// pendant, une commande annulée aurait déjà envoyé son reçu ; s'il partait
/// avant, une panne d'expéditeur ferait échouer la commande. On écrit donc
/// l'intention dans la même transaction que le fait, et un passage l'envoie
/// ensuite.
model EmailOutbox {
  id String @id @default(cuid())

  /// Ce qui empêche le doublon.
  ///
  /// Dérivée du fait qui justifie l'envoi — « recu-<orderItemId> » — et non
  /// d'un hasard : un webhook rejoué par l'opérateur doit retomber sur la même
  /// clé et se faire refuser, plutôt que d'envoyer un second reçu.
  idempotencyKey String @unique

  recipient String
  template  EmailTemplate
  /// Les variables du modèle. Peut contenir un lien de téléchargement :
  /// ne jamais l'afficher tel quel dans un écran ni dans un journal.
  payload   Json

  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?

  /// Avant cette date, la ligne n'est pas réclamée. Porte le recul progressif.
  nextAttemptAt DateTime @default(now())

  /// Posée à la réclamation. Une ligne SENDING dont la réclamation traîne
  /// signale un processus mort en plein envoi.
  claimedAt DateTime?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// L'index du passage : ce qui est dû, dans l'ordre où c'est dû.
  @@index([status, nextAttemptAt])
  /// La supervision lit par récence.
  @@index([createdAt])
  @@index([status, createdAt])
}

model MediaAsset {
  id               String      @id @default(cuid())
  ownerId          String
  purpose          String // shot | product | avatar | banner | preview
  s3Key            String      @unique
  checksum         String
  sizeBytes        Int
  contentType      String
  width            Int?
  height           Int?
  status           MediaStatus @default(PROCESSING)
  shieldLevel      ShieldLevel @default(WATERMARK_ONLY)
  watermarkPayload String? // ownerId + assetId + horodatage, chiffré
  c2paManifestId   String?
  phash            String? // empreinte perceptuelle — recherche inversée
  createdAt        DateTime    @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workImages   WorkImage[]
  productFiles ProductFile[]

  @@index([ownerId, createdAt])
  @@index([phash])
}

model UploadReservation {
  id           String   @id @default(cuid())
  ownerId      String
  purpose      String
  filename     String
  byteSize     Int
  checksum     String
  s3Key        String   @unique
  presignedUrl String   @db.Text
  expiresAt    DateTime
  status       String   @default("pending") // pending | uploaded | expired
  createdAt    DateTime @default(now())

  @@index([ownerId, status])
}

// ============================================================================
// 12. NOTIFICATIONS JURIDIQUES — articles 46 à 54 de la loi ivoirienne
//     n° 2013-451 du 19 juin 2013 relative à la lutte contre la cybercriminalité
// ============================================================================

/// Où en est un dossier.
///
/// L'enchaînement suit le chapitre 6 de la loi ivoirienne n° 2013-451, et non
/// le DMCA américain. La différence n'est pas cosmétique : l'article 47 exige
/// que le notifiant ait **d'abord écrit à l'auteur**, ce que le DMCA ne
/// demande pas.
///
/// Le régime n'est pas dans la loi n° 2013-546 sur les transactions
/// électroniques — celle qui transpose l'acte CEDEAO A/SA.2/01/10 — mais dans
/// la loi pénale. Cherché au mauvais endroit d'abord ; noté ici pour le
/// suivant.
enum LegalNoticeState {
  /// Déposée, pas encore examinée.
  RECUE
  /// Il manque un ou plusieurs des éléments de l'article 47. Tant qu'elle est
  /// incomplète, la connaissance n'est PAS présumée acquise — l'obligation
  /// d'agir promptement (article 46) ne court donc pas.
  INCOMPLETE
  /// Complète : la connaissance est présumée, et le contenu est retiré le temps
  /// de l'examen. « Provisoire » veut dire réversible.
  RETRAIT_PROVISOIRE
  /// L'auteur a répondu. La décision revient à la plateforme, ou au juge.
  CONTESTEE
  /// Tranchée : le contenu ne revient pas.
  RETIREE
  /// Tranchée : le contenu est remis en ligne.
  RESTAUREE
  /// Classée sans suite — abandonnée, non fondée, ou hors sujet.
  CLASSEE
}

/// Qui notifie. L'article 47 demande des éléments différents selon le cas.
enum LegalNoticeNotifierKind {
  /// Nom, prénoms, profession, domicile, nationalité, date et lieu de
  /// naissance.
  PERSONNE_PHYSIQUE

  /// Dénomination et siège social, **et rien d'autre**. La loi sénégalaise
  /// exige en plus la forme juridique et l'organe représentant ; la loi
  /// ivoirienne non, et les réclamer ferait refuser des notifications qu'elle
  /// tient pour complètes.
  PERSONNE_MORALE
}

/// Une notification de contenu litigieux.
///
/// ══════════════════════════════════════════════════════════════════════════
/// LES CHAMPS SONT CEUX DE L'ARTICLE 47, UN POUR UN
///
/// « Pour être prise en compte la notification doit comporter les éléments
/// suivants : […] » — six éléments, énumérés par tirets. Le verbatim complet
/// est en tête de `lib/juridique/article47.ts`.
///
/// C'est une liste fermée, et c'est son intérêt : une notification qui la
/// respecte déclenche l'obligation d'agir promptement (article 46) ;
/// une notification incomplète ne la déclenche pas. Ranger chaque élément dans
/// sa propre colonne permet de dire **lequel** manque, plutôt que de refuser en
/// bloc.
///
/// ══════════════════════════════════════════════════════════════════════════
/// AUCUN DÉLAI CHIFFRÉ NE VIENT DE CE TEXTE
///
/// L'article 46 dit « promptement », sans chiffre. Les délais que porte ce
/// modèle — retrait provisoire, fenêtre de réponse — sont des **engagements de
/// Baobart**, pas des obligations légales. Ils sont rangés ici pour être tenus
/// et vérifiables, et l'écran public le dit en toutes lettres.
///
/// Un seul chiffre vient de la loi, et il est ailleurs : l'article 53 impose
/// de conserver **trois ans** les données permettant d'identifier qui a
/// contribué à un contenu.
///
/// ══════════════════════════════════════════════════════════════════════════
/// NOTIFIER DE MAUVAISE FOI EST UN DÉLIT
///
/// Article 49 : un à cinq ans d'emprisonnement et 1 à 5 millions de francs CFA
/// pour qui présente de mauvaise foi un contenu comme illicite afin d'en
/// obtenir le retrait. C'est la meilleure protection du créateur dans tout ce
/// dispositif, et l'écran de dépôt l'affiche.
model LegalNotice {
  id String @id @default(cuid())

  /// « NOT-2026-041 ». Lisible, citable dans une correspondance, et distincte
  /// de l'identifiant technique — on ne fait pas recopier un cuid à quelqu'un
  /// qui écrit un courrier recommandé.
  reference String @unique

  state LegalNoticeState @default(RECUE)

  /// La date de la notification.
  ///
  /// Absente de la liste ivoirienne — la loi sénégalaise la demande, pas
  /// celle-ci. On la range quand même, et c'est le SERVEUR qui la pose : c'est
  /// elle qui fait courir l'obligation d'agir promptement, et une date déclarée
  /// par le notifiant serait la seule pièce du dossier qu'il pourrait
  /// antidater.
  notifiedAt DateTime @default(now())

  // ── L'auteur de la notification ───────────────────────────────────────────
  notifierKind           LegalNoticeNotifierKind
  notifierEmail          String
  /// Nom (personne physique) ou dénomination (personne morale).
  notifierName           String
  notifierFirstNames     String?
  notifierProfession     String?
  /// Domicile, ou siège social.
  notifierAddress        String
  notifierNationality    String?
  notifierBirthDate      DateTime?
  notifierBirthPlace     String?
  /// Non exigés par l'article 47 ivoirien — conservés parce que la loi
  /// sénégalaise les demande, et que Baobart peut servir les deux pays.
  /// Facultatifs ici, et le formulaire ne les réclame pas.
  notifierLegalForm      String?
  notifierRepresentative String?

  // ── Le destinataire du service en cause ───────────────────────────────────
  /// Le destinataire : celui dont le contenu est visé. Déclaré par le
  /// notifiant, et jamais présumé — la plateforme le rapproche ensuite de ses
  /// propres comptes, sans le remplacer.
  targetName       String
  /// L'article 47 demande « les nom, PRÉNOMS et domicile du destinataire ».
  targetFirstNames String?
  targetAddress    String?
  /// Le compte visé, quand la plateforme a su le rapprocher. Nul tant que
  /// personne ne l'a fait : deviner serait retirer le contenu de quelqu'un sur
  /// une homonymie.
  targetUserId     String?

  // ── Les faits, et leur localisation précise sur le réseau ─────────────────
  /// « la description des faits litigieux et leur localisation précise sur le
  /// réseau ».
  factsDescription String @db.Text
  /// Les adresses exactes. Une par ligne — « tout mon site » n'est pas une
  /// localisation précise, et la validation le refuse.
  targetUrls       String @db.Text

  // ── Les droits et les motifs ──────────────────────────────────────────────
  /// « les droits et les motifs pour lesquels le retrait du contenu litigieux
  /// est demandé ».
  /// Un seul champ : la loi ivoirienne n'en fait pas deux. La loi sénégalaise
  /// sépare « dispositions légales » et « justifications de faits » ; scinder
  /// ici obligerait à répartir une phrase entre deux cases, et ferait refuser
  /// une notification qui dit tout dans la première.
  legalGrounds String @db.Text

  // ── La correspondance préalable ───────────────────────────────────────────
  /// La copie de la correspondance adressée à l'auteur, OU la justification de
  /// ce qu'il n'a pu être contacté. L'un des deux, jamais aucun : c'est
  /// l'exigence que le DMCA n'a pas, et elle oblige à parler à la personne
  /// avant de s'adresser à la plateforme.
  priorContact            String  @db.Text
  /// Vrai quand `priorContact` explique pourquoi l'auteur n'a pu être joint,
  /// plutôt que de reproduire la lettre qu'on lui a envoyée.
  priorContactUnreachable Boolean @default(false)

  // ── Le traitement ─────────────────────────────────────────────────────────
  /// Ce qui manque, quand l'état vaut INCOMPLETE. Les exigences de l'article
  /// 47, séparées par des virgules : « localisation, correspondance ».
  missingElements String?
  /// Quand le contenu a été retiré à titre provisoire.
  suspendedAt     DateTime?
  /// Jusqu'à quand l'auteur peut répondre. Engagement de Baobart, pas délai
  /// légal.
  replyDueAt      DateTime?
  /// Qui a tranché, et pourquoi.
  decidedById     String?
  decidedAt       DateTime?
  decisionReason  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies     LegalNoticeReply[]
  suspensions LegalSuspension[]

  /// La file : « les dossiers qui attendent, le plus ancien d'abord ».
  @@index([state, notifiedAt])
  @@index([targetUserId])
}

/// La réponse de l'auteur dont le contenu est visé.
///
/// Distincte du droit de réponse de l'article 6, qui vise autre chose — être
/// nommé dans un service — et court sur trois mois. Celle-ci conteste le
/// retrait lui-même.
/// Ce qu'un dossier juridique a effectivement retiré, et comment le rendre.
///
/// ─────────────────────────────────────────────────────────────────────────
/// « PROVISOIRE » EST UNE PROMESSE, ET ELLE A BESOIN D'UNE MÉMOIRE
///
/// `RETRAIT_PROVISOIRE` annonce que le contenu reviendra si la notification
/// ne tient pas. Le remettre en `PUBLISHED` par défaut trahirait la promesse
/// dans un cas : une ressource qui était en brouillon au moment du retrait
/// serait publiée par sa restauration, sans que son auteur l'ait demandé.
///
/// D'où `previousStatus` : on rend l'état qu'on a pris, pas l'état qu'on
/// suppose.
///
/// ─────────────────────────────────────────────────────────────────────────
/// DEUX DOSSIERS PEUVENT VISER LE MÊME CONTENU
///
/// La ligne n'est pas supprimée à la levée, elle est datée (`liftedAt`). Deux
/// notifications distinctes sur la même ressource posent deux lignes ; lever
/// la première ne doit pas remettre en ligne ce que la seconde retient encore.
/// C'est la raison d'être de l'index sur `[productId, liftedAt]`.
model LegalSuspension {
  id        String @id @default(cuid())
  noticeId  String
  productId String

  /// L'état à rendre. Jamais SUSPENDED : quand un second dossier suspend une
  /// ressource déjà suspendue, on recopie l'état d'origine plutôt que de
  /// l'empiler — sinon la dernière levée la laisserait suspendue pour
  /// toujours.
  previousStatus ProductStatus

  suspendedAt DateTime  @default(now())
  /// Nul tant que la suspension court.
  liftedAt    DateTime?

  notice  LegalNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Un dossier ne suspend une ressource qu'une fois.
  @@unique([noticeId, productId])
  /// « cette ressource est-elle encore retenue par un autre dossier ? »
  @@index([productId, liftedAt])
}

model LegalNoticeReply {
  id       String @id @default(cuid())
  noticeId String

  /// L'auteur, quand il répond depuis son compte. Nul quand la réponse arrive
  /// par un autre canal et qu'un administrateur la consigne.
  authorId String?
  /// Ce qu'il répond.
  body     String  @db.Text
  /// Il maintient que le contenu est licite et demande sa remise en ligne.
  contests Boolean @default(true)

  createdAt DateTime @default(now())

  notice LegalNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId, createdAt])
}
