// 6. GAMIFICATION
// ============================================================================

model Badge {
  id          String    @id @default(cuid())
  code        BadgeCode @unique
  name        String
  description String
  criteria    Json      @default("{}") // formules publiées — transparence §2.6

  awards UserBadge[]
}

model UserBadge {
  id         String    @id @default(cuid())
  userId     String
  badgeId    String
  awardedAt  DateTime  @default(now())
  validUntil DateTime? // cycles glissants

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ============================================================================
// 7. JOBS, ÉVÉNEMENTS, SERVICES  (M3-M4 — FK scalaires pour l'instant)
// ============================================================================

model JobPosting {
  id          String    @id @default(cuid())
  recruiterId String
  title       String
  type        JobType
  mode        JobMode
  country     String?
  city        String?
  salaryMin   Int?
  salaryMax   Int?
  currency    Currency  @default(XOF)
  description String    @db.Text
  deadline    DateTime?
  status      String    @default("published") // draft | published | filled | closed
  isFeatured  Boolean   @default(false) // offre payante §2.9
  isVerified  Boolean   @default(false) // badge « Offre vérifiée » — anti-arnaque
